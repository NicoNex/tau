# sha256 - the hash of FIPS 180-4.
#
#	sha256 = import("crypto/sha256")
#
#	sha256.Hex("abc")  # ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
#	sha256.Sum(data)   # the same 32 bytes, unencoded
#
# It is written in tau, one 64 byte block at a time, so it is meant for
# checksums, signatures and tokens rather than for hashing a large file.

hex = import("encoding/hex")

# Size is how many bytes a digest takes, BlockSize how many bytes go into the
# compression function at once. HMAC needs both.
Size = 32
BlockSize = 64

mask32 = 0xffffffff

# The first 32 bits of the fractional parts of the cube roots of the first 64
# primes, which is where the constants of the round function come from.
K = [
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
	0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
	0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
	0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
	0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
	0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
	0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
	0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
	0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

# The first 32 bits of the fractional parts of the square roots of the first
# eight primes: the state a hash starts from.
initial = [
	0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
	0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

# rotr turns the bits of a 32 bit word right, the ones falling off the end
# coming back at the top.
rotr = fn(x, n) { ((x >> n) | (x << (32 - n))) & mask32 }

# block runs the compression function over the 64 bytes of b starting at off,
# and returns the new state.
block = fn(state, b, off) {
	# The sixteen words of the block, then the forty eight the round function
	# derives from them.
	w = []
	for i = 0; i < 16; ++i {
		j = off + i * 4
		w = append(w, (b[j] << 24) | (b[j + 1] << 16) | (b[j + 2] << 8) | b[j + 3])
	}
	for i = 16; i < 64; ++i {
		s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
		s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
		w = append(w, (w[i - 16] + s0 + w[i - 7] + s1) & mask32)
	}

	a = state[0]
	bb = state[1]
	c = state[2]
	d = state[3]
	e = state[4]
	f = state[5]
	g = state[6]
	h = state[7]

	for i = 0; i < 64; ++i {
		s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
		ch = (e & f) ^ ((~e & mask32) & g)
		t1 = (h + s1 + ch + K[i] + w[i]) & mask32
		s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
		maj = (a & bb) ^ (a & c) ^ (bb & c)
		t2 = (s0 + maj) & mask32

		h = g
		g = f
		f = e
		e = (d + t1) & mask32
		d = c
		c = bb
		bb = a
		a = (t1 + t2) & mask32
	}

	return [
		(state[0] + a) & mask32,
		(state[1] + bb) & mask32,
		(state[2] + c) & mask32,
		(state[3] + d) & mask32,
		(state[4] + e) & mask32,
		(state[5] + f) & mask32,
		(state[6] + g) & mask32,
		(state[7] + h) & mask32
	]
}

# Sum returns the 32 bytes of the digest of data, a string or bytes.
Sum = fn(data) {
	if type(data) != "bytes" {
		if failed(data = bytes(string(data))) {
			return data
		}
	}

	# The padded message: the data, a 0x80 byte, zeroes up to eight bytes short
	# of a whole block, and the length in bits as a 64 bit number.
	n = len(data)
	padded = []
	for i = 0; i < n; ++i {
		padded = append(padded, data[i])
	}
	padded = append(padded, 0x80)
	for len(padded) % 64 != 56 {
		padded = append(padded, 0)
	}

	bits = n * 8
	for i = 7; i >= 0; --i {
		padded = append(padded, (bits >> (i * 8)) & 0xff)
	}

	b = bytes(padded)
	state = initial
	for off = 0; off < len(b); off = off + 64 {
		state = block(state, b, off)
	}

	out = []
	for i = 0; i < 8; ++i {
		out = append(out,
			(state[i] >> 24) & 0xff,
			(state[i] >> 16) & 0xff,
			(state[i] >> 8) & 0xff,
			state[i] & 0xff)
	}
	return bytes(out)
}

# Hex returns the digest of data as the 64 hexadecimal digits it is usually
# written with.
Hex = fn(data) { hex.EncodeToString(Sum(data)) }
