# Module C - imports B (which imports A)
b = import("tests/test_nested_b.tau")

print("Testing nested imports...\n")

# Test B's own function
resultB = b.PublicFuncB()
print("B's function returned: ")
print(resultB)
print("\n")

# Test B calling A's function
resultA = b.PublicCallA()
print("A's function (called via B) returned: ")
print(resultA)
print("\n")

if resultB == "Secret from B" && resultA == "Secret from A" {
	print("SUCCESS: All nested closures work correctly!\n")
} else {
	print("FAILED: Closures not preserved correctly\n")
}
