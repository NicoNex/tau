# os - files.
#
# Everything goes through syscall, no dependency on the C library of the host.

syscall = import("syscall")
io = import("io")

O_RDONLY = syscall.O_RDONLY
O_WRONLY = syscall.O_WRONLY
O_RDWR = syscall.O_RDWR
O_CREAT = syscall.O_CREAT
O_TRUNC = syscall.O_TRUNC
O_APPEND = syscall.O_APPEND
O_EXCL = syscall.O_EXCL

bufsize = 32768

newFile = fn(fd, path) {
	f = new()
	f.fd = fd
	f.Name = path

	# Read returns up to n bytes, or an empty bytes value at end of file.
	f.Read = fn(n) {
		if n == null {
			n = bufsize
		}

		buf = bytes(n)
		if failed(read = syscall.Read(f.fd, buf, n)) {
			return read
		}
		return slice(buf, 0, read)
	}

	# ReadAll returns the rest of the file.
	f.ReadAll = fn() { io.ReadAll(f) }

	f.ReadString = fn() { string(f.ReadAll()) }

	# Write writes a string or bytes and returns how many bytes went out.
	f.Write = fn(data) {
		if type(data) != "bytes" {
			if failed(data = bytes(string(data))) {
				return data
			}
		}
		return syscall.Write(f.fd, data, len(data))
	}

	f.Seek = fn(offset, whence) { syscall.Lseek(f.fd, offset, whence) }
	f.Close = fn() { syscall.Close(f.fd) }

	return f
}

# Open returns the file at path open with the given flags. Perm is only used
# when the file is created, 0644 is the usual value.
Open = fn(path, flags, perm) {
	if flags == null {
		flags = O_RDONLY
	}
	if perm == null {
		perm = 0644
	}

	if failed(fd = syscall.Open(path, flags, perm)) {
		return fd
	}
	return newFile(fd, path)
}

# Create opens path for writing, truncating it or creating it as needed.
Create = fn(path) { Open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644) }

# ReadFile returns the whole content of path as bytes.
ReadFile = fn(path) {
	if failed(f = Open(path, O_RDONLY, 0)) {
		return f
	}

	data = f.ReadAll()
	f.Close()
	return data
}

ReadFileString = fn(path) {
	if failed(b = ReadFile(path)) {
		return b
	}
	return string(b)
}

# WriteFile writes data, a string or bytes, to path.
WriteFile = fn(path, data) {
	if failed(f = Create(path)) {
		return f
	}

	n = f.Write(data)
	f.Close()
	return n
}

Mkdir = fn(path, perm) {
	if perm == null {
		perm = 0755
	}
	return syscall.Mkdir(path, perm)
}

Remove = fn(path) { syscall.Unlink(path) }
Rmdir = fn(path) { syscall.Rmdir(path) }
Chmod = fn(path, mode) { syscall.Chmod(path, mode) }

# Exists reports whether path exists.
Exists = fn(path) { !failed(syscall.Access(path, syscall.F_OK)) }

# ========== Standard Streams ==========

Stdin = newFile(0, "/dev/stdin")
Stdout = newFile(1, "/dev/stdout")
Stderr = newFile(2, "/dev/stderr")

# ========== Arguments and Environment ==========

# args reads the command line the runtime left in the environment, one
# variable per argument, and takes it away so that a process started from here
# doesn't inherit it.
args = fn() {
	n = syscall.Getenv("TAU_ARGC")
	if n == null {
		return []
	}
	syscall.Unsetenv("TAU_ARGC")

	out = []
	for i = 0; i < int(n); ++i {
		name = "TAU_ARG{i}"
		out = append(out, syscall.Getenv(name))
		syscall.Unsetenv(name)
	}
	return out
}

# Args is the command line: the program itself first, then its arguments.
Args = args()

# Getenv returns the value of the environment variable name, or an empty
# string when it isn't set. LookupEnv tells the two apart.
Getenv = fn(name) {
	v = syscall.Getenv(name)
	if v == null {
		return ""
	}
	return v
}

# LookupEnv returns the value of name and whether it was set at all.
LookupEnv = fn(name) {
	v = syscall.Getenv(name)
	return [if v == null { "" } else { v }, v != null]
}

Setenv = fn(name, value) { syscall.Setenv(name, value) }
Unsetenv = fn(name) { syscall.Unsetenv(name) }

# ========== Files and Directories ==========

Rename = fn(from, to) { syscall.Rename(from, to) }
Getwd = fn() { syscall.Getwd() }
Chdir = fn(path) { syscall.Chdir(path) }

# TempDir returns the directory for temporary files.
TempDir = fn() {
	d = syscall.Getenv("TMPDIR")
	if d == null {
		return "/tmp"
	}
	return d
}

# Stat returns what is known about the file at path: its Name, Size in bytes,
# Mode, whether it IsDir and when it was last modified, in seconds since the
# Unix epoch.
Stat = fn(path) {
	if failed(size = syscall.StatSize(path)) {
		return size
	}
	if failed(mode = syscall.StatMode(path)) {
		return mode
	}
	if failed(mtime = syscall.StatMtime(path)) {
		return mtime
	}

	st = new()
	st.Name = path
	st.Size = size
	st.Mode = mode
	st.Perm = mode & 0777
	st.IsDir = (mode & syscall.S_IFMT) == syscall.S_IFDIR
	st.ModTime = mtime
	return st
}

# IsDir reports whether path is a directory. A path that isn't there is not.
IsDir = fn(path) {
	d = syscall.StatIsDir(path)
	if failed(d) {
		return false
	}
	return d
}

# ReadDir returns the names inside the directory at path, sorted, without
# "." and "..".
ReadDir = fn(path) {
	if failed(names = syscall.Readdirnames(path)) {
		return names
	}

	out = []
	for i = 0; i < len(names); ++i {
		if names[i] != "." && names[i] != ".." {
			out = append(out, names[i])
		}
	}
	return sorted(out)
}

# sorted returns the strings in order. Insertion sort: a directory holds few
# enough names that anything smarter would only be longer to read.
sorted = fn(l) {
	for i = 1; i < len(l); ++i {
		v = l[i]
		j = i - 1
		for j >= 0 && l[j] > v {
			l[j+1] = l[j]
			--j
		}
		l[j+1] = v
	}
	return l
}

# MkdirAll creates path and every directory missing above it.
MkdirAll = fn(path, perm) {
	if perm == null {
		perm = 0755
	}
	if IsDir(path) {
		return null
	}

	parts = []
	start = 0
	for i = 0; i < len(path); ++i {
		if path[i] == "/" {
			parts = append(parts, slice(path, start, i))
			start = i + 1
		}
	}
	parts = append(parts, slice(path, start, len(path)))

	# An absolute path starts with an empty part, which rebuilds the leading
	# slash on its own.
	cur = ""
	for i = 0; i < len(parts); ++i {
		if parts[i] == "" {
			cur = "/"
			continue
		}

		cur = if cur == "" || cur == "/" { cur + parts[i] } else { cur + "/" + parts[i] }
		if !IsDir(cur) {
			if failed(err = Mkdir(cur, perm)) {
				return err
			}
		}
	}
	return null
}

# RemoveAll removes path and everything under it.
RemoveAll = fn(path) {
	if !IsDir(path) {
		if !Exists(path) {
			return null
		}
		return Remove(path)
	}

	if failed(names = ReadDir(path)) {
		return names
	}
	for i = 0; i < len(names); ++i {
		if failed(err = RemoveAll(path + "/" + names[i])) {
			return err
		}
	}
	return Rmdir(path)
}
