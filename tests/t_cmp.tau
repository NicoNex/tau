cmp = import("cmp")
strconv = import("strconv")
errors = import("errors")

println(cmp.Equal([1,2,[3]], [1,2,[3]]), cmp.Equal([1,2], [1,3]))
println(cmp.Equal({"a":1}, {"a":1}), cmp.Equal({"a":1}, {"a":2}))
o1 = new(); o1.x = 1
o2 = new(); o2.x = 1
println(cmp.Equal(o1, o2), cmp.Compare(2,3), cmp.Compare("b","a"), cmp.Min(3,1), cmp.Max(3,1))
println(strconv.Atoi("123"), strconv.Atoi("-45"), type(strconv.Atoi("abc")))
println(strconv.ParseInt("ff", 16), strconv.ParseInt("1010", 2))
println(strconv.ParseFloat("3.25"), strconv.ParseFloat("-0.5"), type(strconv.ParseFloat("x")))
println(strconv.FormatInt(255, 16), strconv.FormatInt(-10, 2))
e = errors.Wrap(errors.New("no such file"), "opening config")
println(string(e), errors.Is(e, "no such file"), errors.Is(e, "nope"))
