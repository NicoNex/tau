# concurrency with allocation: every routine builds garbage while the others
# do the same, which is what makes the collector and the heap contend.
worker = fn(p, n) {
	last = []
	for i = 0; i < n; ++i {
		last = [i, i + 1, "s{i}"]
	}
	send(p, len(last))
}

p = pipe()
n = 8
for w = 0; w < n; ++w {
	tau worker(p, 60000)
}

total = 0
for i = 0; i < n; ++i {
	total = total + recv(p)
}
println(total)
