# net_go_style.tau - Examples using Go-style net library API
# These examples mirror the patterns used in Go's net package

import("stdlib/net.tau")

# Example 1: TCP Echo Server (like Go's net.Listen + Accept pattern)
# Go equivalent:
#   ln, _ := net.Listen("tcp", ":8080")
#   conn, _ := ln.Accept()
tcpEchoServer = fn() {
	print("Starting TCP echo server...")

	# Listen for connections (like Go's net.Listen)
	ln = Listen("tcp", ":8080")
	if failed(ln) {
		print("Listen error: {ln}")
		return ln
	}

	print("Server listening on :8080")

	# Accept connections in a loop
	for {
		# Accept new connection (like Go's ln.Accept())
		conn = ln.Accept()
		if failed(conn) {
			print("Accept error: {conn}")
			continue
		}

		print("Client connected")

		# Handle connection
		for {
			# Read from connection (like Go's conn.Read())
			data = conn.Read(1024)
			if failed(data) {
				print("Read error: {data}")
				break
			}

			if len(data) == 0 {
				print("Client disconnected")
				break
			}

			print("Received: {string(data)}")

			# Write back to connection (like Go's conn.Write())
			n = conn.Write(data)
			if failed(n) {
				print("Write error: {n}")
				break
			}
		}

		# Close connection (like Go's conn.Close())
		conn.Close()
	}

	ln.Close()
}

# Example 2: TCP Client (like Go's net.Dial pattern)
# Go equivalent:
#   conn, _ := net.Dial("tcp", "localhost:8080")
#   conn.Write([]byte("Hello"))
tcpClient = fn() {
	print("Connecting to server...")

	# Dial connection (like Go's net.Dial)
	conn = Dial("tcp", "localhost:8080")
	if failed(conn) {
		print("Dial error: {conn}")
		return conn
	}

	print("Connected!")

	# Send messages
	messages = ["Hello", "World", "From", "Tau"]

	for i = 0; i < len(messages); ++i {
		msg = "{messages[i]}\n"

		# Write to connection (like Go's conn.Write)
		n = conn.Write(msg)
		if failed(n) {
			print("Write error: {n}")
			break
		}

		print("Sent: {msg}")

		# Read response (like Go's conn.Read)
		data = conn.Read(1024)
		if failed(data) {
			print("Read error: {data}")
			break
		}

		print("Received: {string(data)}")
	}

	# Close connection (like Go's conn.Close)
	conn.Close()
	print("Connection closed")
}

# Example 3: UDP Server (like Go's net.ListenPacket pattern)
# Go equivalent:
#   pc, _ := net.ListenPacket("udp", ":9090")
#   pc.ReadFrom(buffer)
udpServer = fn() {
	print("Starting UDP server...")

	# Listen for packets (like Go's net.ListenPacket)
	pc = ListenPacket("udp", ":9090")
	if failed(pc) {
		print("ListenPacket error: {pc}")
		return pc
	}

	print("UDP server listening on :9090")

	# Receive packets
	for i = 0; i < 10; ++i {
		# ReadFrom (like Go's pc.ReadFrom)
		data = pc.ReadFrom(1024)
		if failed(data) {
			print("ReadFrom error: {data}")
			continue
		}

		print("Received UDP: {string(data)}")
	}

	pc.Close()
	print("UDP server closed")
}

# Example 4: UDP Client (like Go's net.Dial for UDP)
# Go equivalent:
#   conn, _ := net.Dial("udp", "localhost:9090")
#   conn.Write([]byte("Hello"))
udpClient = fn() {
	print("Creating UDP client...")

	# Dial UDP (like Go's net.Dial with "udp")
	conn = Dial("udp", "localhost:9090")
	if failed(conn) {
		print("Dial error: {conn}")
		return conn
	}

	messages = ["UDP", "Test", "From", "Tau"]

	for i = 0; i < len(messages); ++i {
		msg = "{messages[i]}\n"

		# Write to connection (like Go's conn.Write for UDP)
		n = conn.Write(msg)
		if failed(n) {
			print("Write error: {n}")
		} else {
			print("Sent UDP: {msg}")
		}
	}

	conn.Close()
	print("UDP client closed")
}

# Example 5: HTTP Server using Go-style patterns
# Go equivalent:
#   ln, _ := net.Listen("tcp", ":8888")
#   for { conn, _ := ln.Accept(); go handleHTTP(conn) }
httpServer = fn() {
	print("Starting HTTP server...")

	# Listen (like Go's net.Listen)
	ln = Listen("tcp", ":8888")
	if failed(ln) {
		print("Listen error: {ln}")
		return ln
	}

	print("HTTP server listening on http://localhost:8888")

	# Handler function
	handler = fn(req) {
		print("{req.Method} {req.Path}")

		if req.Path == "/" {
			body = "Hello from Tau!\n"
		} else if req.Path == "/api/status" {
			body = '{"status":"ok"}\n'
		} else {
			body = "404 Not Found\n"
		}

		response = "HTTP/1.1 200 OK\r\n"
		response += "Content-Type: text/plain\r\n"
		response += "Content-Length: {len(body)}\r\n"
		response += "Connection: close\r\n\r\n"
		response += body

		return response
	}

	# Accept and serve requests
	for i = 0; i < 5; ++i {  # Handle 5 requests
		conn = ln.Accept()
		if !failed(conn) {
			HTTPServe(conn, handler)
		}
	}

	ln.Close()
	print("HTTP server closed")
}

# Example 6: Simple HTTP GET using HTTPGet
# Go equivalent would use net/http.Get()
httpClientGet = fn() {
	print("Making HTTP GET request...")

	response = HTTPGet("http://example.com:80/")
	if failed(response) {
		print("HTTP GET error: {response}")
		return response
	}

	print("Response:")
	print(response)
}

# Example 7: Address resolution (like Go's net.ResolveTCPAddr)
# Go equivalent:
#   addr, _ := net.ResolveTCPAddr("tcp", "localhost:8080")
resolveAddress = fn() {
	print("Resolving TCP address...")

	addr = ResolveTCPAddr("tcp", "localhost:8080")
	if failed(addr) {
		print("Resolve error: {addr}")
		return addr
	}

	print("IP: {addr.IP}")
	print("Port: {addr.Port}")
	print("String: {addr.String()}")
}

# Example 8: Using SplitHostPort and JoinHostPort (like Go's net package)
# Go equivalent:
#   host, port, _ := net.SplitHostPort("example.com:80")
#   addr := net.JoinHostPort(host, port)
addressUtilities = fn() {
	print("\nAddress Utilities:")

	# SplitHostPort (like Go's net.SplitHostPort)
	result = SplitHostPort("example.com:8080")
	if !failed(result) {
		print("Host: {result.Host}")
		print("Port: {result.Port}")

		# JoinHostPort (like Go's net.JoinHostPort)
		addr = JoinHostPort(result.Host, result.Port)
		print("Rejoined: {addr}")
	}
}

# Example 9: ParseIP (like Go's net.ParseIP)
# Go equivalent:
#   ip := net.ParseIP("192.168.1.1")
parseIPAddress = fn() {
	print("\nParsing IP address:")

	ip = ParseIP("192.168.1.1")
	if failed(ip) {
		print("ParseIP error: {ip}")
	} else {
		print("Parsed IP: {ip.String()}")
	}
}

# Example 10: Connection with explicit methods (showing the full Go-style API)
fullConnectionExample = fn() {
	print("Full connection example:")

	# Connect (like Go's net.Dial)
	conn = Dial("tcp", "example.com:80")
	if failed(conn) {
		print("Connection failed: {conn}")
		return conn
	}

	print("Connected!")

	# Get addresses (like Go's conn.LocalAddr() and conn.RemoteAddr())
	print("Local address: {conn.LocalAddr()}")
	print("Remote address: {conn.RemoteAddr()}")

	# Write HTTP request (like Go's conn.Write)
	request = "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
	n = conn.Write(request)

	if failed(n) {
		print("Write failed: {n}")
	} else {
		print("Wrote {n} bytes")

		# Read response (like Go's conn.Read)
		response = ""
		for {
			chunk = conn.Read(4096)
			if failed(chunk) || len(chunk) == 0 {
				break
			}
			response += string(chunk)
		}

		print("Response length: {len(response)} bytes")
	}

	# Close (like Go's conn.Close)
	err = conn.Close()
	if failed(err) {
		print("Close error: {err}")
	} else {
		print("Connection closed cleanly")
	}
}

# Main - run examples
print("Tau Net Library - Go-Style Examples")
print("====================================\n")

print("These examples demonstrate Go-style networking patterns:")
print("- Dial() / Listen() for creating connections")
print("- Read() / Write() for I/O operations")
print("- Accept() for accepting connections")
print("- Close() for cleanup")
print("\nUncomment examples to run them:\n")

# Uncomment to run specific examples:

# Server examples (run these first):
# tcpEchoServer()
# udpServer()
# httpServer()

# Client examples (run after servers):
# tcpClient()
# udpClient()
# httpClientGet()

# Utility examples (run anytime):
addressUtilities()
parseIPAddress()
resolveAddress()
