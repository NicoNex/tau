#!/usr/bin/env tau

# Test concurrent access to global variables
# This verifies that the mutex protection works correctly

global_list = []

append_worker = fn(id, result_pipe) {
    for i = 0; i < 50; i = i + 1 {
        # Read global, modify it, write back (all protected by mutex)
        current = global_list
        global_list = append(current, id)
    }
    send(result_pipe, true)
}

p = pipe(4)

# Spawn 4 concurrent workers that all modify the same global list
tau append_worker(1, p)
tau append_worker(2, p)
tau append_worker(3, p)
tau append_worker(4, p)

# Wait for all workers to complete
for i = 0; i < 4; i = i + 1 {
    recv(p)
}

final_length = len(global_list)
println("Final list length:", final_length)
println("Expected: 200 (4 workers × 50 appends)")

if final_length == 200 {
    println("SUCCESS: All operations completed without data loss")
} else {
    println("FAILURE: Some operations were lost due to race conditions")
}
