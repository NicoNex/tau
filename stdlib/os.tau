# os - files.
#
# Everything goes through syscall, no dependency on the C library of the host.

syscall = import("syscall")

O_RDONLY = syscall.O_RDONLY
O_WRONLY = syscall.O_WRONLY
O_RDWR = syscall.O_RDWR
O_CREAT = syscall.O_CREAT
O_TRUNC = syscall.O_TRUNC
O_APPEND = syscall.O_APPEND
O_EXCL = syscall.O_EXCL

bufsize = 32768

newFile = fn(fd, path) {
	f = new()
	f.fd = fd
	f.Name = path

	# Read returns up to n bytes, or an empty bytes value at end of file.
	f.Read = fn(n) {
		if n == null {
			n = bufsize
		}

		buf = bytes(n)
		if failed(read = syscall.Read(f.fd, buf, n)) {
			return read
		}
		return slice(buf, 0, read)
	}

	# ReadAll returns the rest of the file.
	f.ReadAll = fn() {
		out = []

		for true {
			if failed(chunk = f.Read(bufsize)) {
				return chunk
			}
			if len(chunk) == 0 {
				return bytes(out)
			}
			for i = 0; i < len(chunk); ++i {
				out = append(out, chunk[i])
			}
		}
	}

	f.ReadString = fn() { string(f.ReadAll()) }

	# Write writes a string or bytes and returns how many bytes went out.
	f.Write = fn(data) {
		if type(data) != "bytes" {
			if failed(data = bytes(string(data))) {
				return data
			}
		}
		return syscall.Write(f.fd, data, len(data))
	}

	f.Seek = fn(offset, whence) { syscall.Lseek(f.fd, offset, whence) }
	f.Close = fn() { syscall.Close(f.fd) }

	return f
}

# Open returns the file at path open with the given flags. Perm is only used
# when the file is created, 0644 is the usual value.
Open = fn(path, flags, perm) {
	if flags == null {
		flags = O_RDONLY
	}
	if perm == null {
		perm = 0644
	}

	if failed(fd = syscall.Open(path, flags, perm)) {
		return fd
	}
	return newFile(fd, path)
}

# Create opens path for writing, truncating it or creating it as needed.
Create = fn(path) { Open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644) }

# ReadFile returns the whole content of path as bytes.
ReadFile = fn(path) {
	if failed(f = Open(path, O_RDONLY, 0)) {
		return f
	}

	data = f.ReadAll()
	f.Close()
	return data
}

ReadFileString = fn(path) {
	if failed(b = ReadFile(path)) {
		return b
	}
	return string(b)
}

# WriteFile writes data, a string or bytes, to path.
WriteFile = fn(path, data) {
	if failed(f = Create(path)) {
		return f
	}

	n = f.Write(data)
	f.Close()
	return n
}

Mkdir = fn(path, perm) {
	if perm == null {
		perm = 0755
	}
	return syscall.Mkdir(path, perm)
}

Remove = fn(path) { syscall.Unlink(path) }
Rmdir = fn(path) { syscall.Rmdir(path) }
Chmod = fn(path, mode) { syscall.Chmod(path, mode) }

# Exists reports whether path exists.
Exists = fn(path) { !failed(syscall.Access(path, syscall.F_OK)) }
