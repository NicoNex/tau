# math - the usual functions on floats.
#
# Everything returns a float, whatever it was given, so an integer handed to
# one of these comes back as a float and stays one through the arithmetic that
# follows.
#
# The functions are the ones of the C math library, called with their real
# signatures through the ffi module: no shared object of our own in between,
# since the interpreter is already linked against libm and dlopen(null) is the
# handle of the program itself.

ffi = import("ffi")

# The C library the program was linked against.
libm = dlopen(null)

Pi = 3.141592653589793
E = 2.718281828459045
Sqrt2 = 1.4142135623730951
SqrtPi = 1.772453850905516
Ln2 = 0.6931471805599453
Ln10 = 2.302585092994046

# MaxInt is the largest integer that fits in a tau int, MinInt the smallest.
MaxInt = 9223372036854775807
MinInt = -9223372036854775807 - 1

# The functions themselves, taken from the library by their declarations.
c = ffi.Bind(libm, [
		"double sqrt(double)",
		"double cbrt(double)",
		"double exp(double)",
		"double log(double)",
		"double log2(double)",
		"double log10(double)",
		"double sin(double)",
		"double cos(double)",
		"double tan(double)",
		"double asin(double)",
		"double acos(double)",
		"double atan(double)",
		"double sinh(double)",
		"double cosh(double)",
		"double tanh(double)",
		"double floor(double)",
		"double ceil(double)",
		"double round(double)",
		"double trunc(double)",
		"double pow(double, double)",
		"double atan2(double, double)",
		"double fmod(double, double)",
		"double hypot(double, double)",
		"int isnan(double)",
		"int isinf(double)"
	])

# f1 and f2 take whatever they are given as a float, so that Sqrt(2) works as
# well as Sqrt(2.0).
f1 = fn(fun) {
	return fn(x) { fun(float(x)) }
}

f2 = fn(fun) {
	return fn(x, y) { fun(float(x), float(y)) }
}

Sqrt = f1(c.sqrt)
Cbrt = f1(c.cbrt)
Exp = f1(c.exp)
Log = f1(c.log)
Log2 = f1(c.log2)
Log10 = f1(c.log10)
Sin = f1(c.sin)
Cos = f1(c.cos)
Tan = f1(c.tan)
Asin = f1(c.asin)
Acos = f1(c.acos)
Atan = f1(c.atan)
Sinh = f1(c.sinh)
Cosh = f1(c.cosh)
Tanh = f1(c.tanh)
Floor = f1(c.floor)
Ceil = f1(c.ceil)
Round = f1(c.round)
Trunc = f1(c.trunc)

Pow = f2(c.pow)
Atan2 = f2(c.atan2)
Mod = f2(c.fmod)
Hypot = f2(c.hypot)

# Abs is the absolute value, an integer staying an integer: it is the one case
# where going through a float would lose the largest values.
Abs = fn(x) { if x < 0 { -x } else { x } }

# Inf returns positive infinity, or negative when sign is negative. A division
# is how a float says it, and there is no function to ask for one.
Inf = fn(sign) {
	if sign != null && sign < 0 {
		return -1.0 / 0.0
	}
	return 1.0 / 0.0
}

# NaN returns a value that is not a number, and IsNaN is how to recognise one:
# != does not follow IEEE here, so x != x is not the test it is in C.
NaN = fn() { 0.0 / 0.0 }
IsNaN = fn(x) { c.isnan(float(x)) != 0 }
IsInf = fn(x) { c.isinf(float(x)) != 0 }

Min = fn(a, b) { if a < b { a } else { b } }
Max = fn(a, b) { if a > b { a } else { b } }

# Signum is -1, 0 or 1, following the sign of x.
Signum = fn(x) {
	if x > 0 {
		return 1
	}
	if x < 0 {
		return -1
	}
	return 0
}
