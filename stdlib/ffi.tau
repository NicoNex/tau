# ffi - calling C with the types written down.
#
# A shared object is opened with dlopen, and the dot on it gives a symbol.
# That symbol can be called straight away, which is quick and takes your word
# for the types; or it can be given a signature, which is what this module is
# for:
#
#	ffi = import("ffi")
#	libm = dlopen("libm.so.6")
#
#	pow = ffi.Func(libm.pow, "double pow(double, double)")
#	println(pow(2.0, 10.0))     # 1024, a float and not a machine word
#
# The signature is a C declaration. The name of the function and the names of
# the arguments may be there or not, so a line copied out of a header works as
# it stands, and const, volatile and restrict are read and ignored:
#
#	snprintf = ffi.Func(libc.snprintf,
#		"int snprintf(char *s, size_t n, const char *fmt, double x)")
#
# The widths C leaves to the machine - char, short, int, long, size_t - are
# the widths of this machine. The exact width names of stdint.h work too, and
# so do the tau spellings of the same: uint64 and uint64_t, float64 and
# double.
#
# ponytail: a signature is parsed with a scan and a table, not a grammar. It
# reads declarations, not C: a function pointer parameter is not understood,
# and neither is a struct passed by value.

runtime = import("runtime")
strings = import("strings")

# The type codes, which are the other half of an agreement with the enum at
# the top of internal/obj/ffi.c: the numbers travel to cfunc and must line up.
Void = 0
Bool = 1
Int8 = 2
UInt8 = 3
Int16 = 4
UInt16 = 5
Int32 = 6
UInt32 = 7
Int64 = 8
UInt64 = 9
Float32 = 10
Float64 = 11
Pointer = 12
CString = 13

# The widths of this machine, which is what makes "long" mean what it means
# here rather than what it meant where the header was written.
ptrBits = if runtime.Arch() == "386" || runtime.Arch() == "arm" { 32 } else { 64 }

# Windows keeps long at 32 bits even at 64 bits of address, everyone else
# grows it with the pointer.
longBits = if runtime.OS() == "windows" { 32 } else { ptrBits }

signed = fn(bits) {
	if bits == 8 { return Int8 }
	if bits == 16 { return Int16 }
	if bits == 32 { return Int32 }
	return Int64
}

unsigned = fn(bits) {
	if bits == 8 { return UInt8 }
	if bits == 16 { return UInt16 }
	if bits == 32 { return UInt32 }
	return UInt64
}

# The names a signature may be written with. The ones C leaves to the machine
# are resolved above; the rest are the width they say.
names = {
	"void": Void,
	"bool": Bool,
	"_Bool": Bool,
	"char": signed(8),
	"signed char": signed(8),
	"unsigned char": unsigned(8),
	"short": signed(16),
	"short int": signed(16),
	"unsigned short": unsigned(16),
	"unsigned short int": unsigned(16),
	"int": signed(32),
	"signed": signed(32),
	"signed int": signed(32),
	"unsigned": unsigned(32),
	"unsigned int": unsigned(32),
	"long": signed(longBits),
	"long int": signed(longBits),
	"unsigned long": unsigned(longBits),
	"unsigned long int": unsigned(longBits),
	"long long": Int64,
	"long long int": Int64,
	"unsigned long long": UInt64,
	"unsigned long long int": UInt64,
	"size_t": unsigned(ptrBits),
	"ssize_t": signed(ptrBits),
	"intptr_t": signed(ptrBits),
	"uintptr_t": unsigned(ptrBits),
	"ptrdiff_t": signed(ptrBits),
	"int8_t": Int8,
	"int8": Int8,
	"uint8_t": UInt8,
	"uint8": UInt8,
	"int16_t": Int16,
	"int16": Int16,
	"uint16_t": UInt16,
	"uint16": UInt16,
	"int32_t": Int32,
	"int32": Int32,
	"uint32_t": UInt32,
	"uint32": UInt32,
	"int64_t": Int64,
	"int64": Int64,
	"uint64_t": UInt64,
	"uint64": UInt64,
	"float": Float32,
	"float32": Float32,
	"double": Float64,
	"float64": Float64,
	"string": CString,
	"pointer": Pointer
}

# The words of a declaration that say nothing about the type.
qualifiers = {
	"const": true,
	"volatile": true,
	"restrict": true,
	"__restrict": true,
	"extern": true,
	"static": true,
	"inline": true
}

isWordByte = fn(c) {
	return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
}

# decl reads one declaration - a result type, or an argument, with or without
# the name that follows it - and returns [code, name], where the name is the
# word that was dropped, or "".
#
# A star anywhere makes it a pointer, and a char * is the one pointer that
# travels as a tau string.
decl = fn(text) {
	words = []
	stars = 0

	i = 0
	for i < len(text) {
		c = text[i]

		if c == " " || c == "\t" || c == "\n" || c == "\r" {
			++i
			continue
		}
		if c == "*" {
			++stars
			++i
			continue
		}

		# An array parameter is a pointer, and what is inside the brackets
		# says nothing about the call.
		if c == "[" {
			++stars
			for i < len(text) && text[i] != "]" {
				++i
			}
			++i
			continue
		}

		if !isWordByte(c) {
			return error("\"{c}\" has no place in a type")
		}

		start = i
		for i < len(text) && isWordByte(text[i]) {
			++i
		}

		word = slice(text, start, i)
		if qualifiers[word] == null {
			words = append(words, word)
		}
	}

	if len(words) == 0 {
		return error("there is no type here")
	}

	# The last word is the name of what is being declared unless it is part of
	# the type: "unsigned long" keeps both words, "unsigned long n" drops the
	# third.
	name = ""
	used = len(words)
	for {
		joined = strings.Join(slice(words, 0, used), " ")
		code = names[joined]

		if code != null {
			if stars > 0 {
				# char * is a string, every other pointer is an address.
				if stars == 1 && (joined == "char" || joined == "signed char") {
					return [CString, name]
				}
				return [Pointer, name]
			}
			return [code, name]
		}

		if used == 1 {
			return error("\"{joined}\" is not a type this understands")
		}
		name = words[used - 1]
		--used
	}
}

# Sig reads a signature and returns [result code, [argument codes], name],
# where the name is the one the declaration gave the function, or "".
#
# It is the parse on its own, for building a call without going through text:
# what it returns is what Func hands to cfunc.
Sig = fn(text) {
	text = strings.TrimSpace(string(text))

	open = strings.Index(text, "(")
	if open < 0 || len(text) == 0 || text[len(text) - 1] != ")" {
		return error("ffi: a signature is a C declaration, \"double(double, double)\", got \"{text}\"")
	}
	if strings.Contains(text, "...") {
		return error("ffi: \"{text}\" is variadic, say the types of the arguments this call passes instead")
	}

	if failed(ret = decl(slice(text, 0, open))) {
		return error("ffi: in the result of \"{text}\": {ret}")
	}

	args = []
	inside = strings.TrimSpace(slice(text, open + 1, len(text) - 1))

	# f() and f(void) are both no arguments at all.
	if inside != "" {
		parts = strings.Split(inside, ",")
		for i = 0; i < len(parts); ++i {
			if failed(a = decl(parts[i])) {
				return error("ffi: in argument {i + 1} of \"{text}\": {a}")
			}

			if a[0] == Void {
				if len(parts) == 1 {
					break
				}
				return error("ffi: argument {i + 1} of \"{text}\" cannot be void")
			}
			args = append(args, a[0])
		}
	}

	return [ret[0], args, ret[1]]
}

# Func returns a callable for the symbol sym, with the types the signature
# says. sym comes from the dot on a shared object:
#
#	libm = dlopen("libm.so.6")
#	pow = ffi.Func(libm.pow, "double pow(double, double)")
Func = fn(sym, signature) {
	if failed(s = Sig(signature)) {
		return s
	}
	return cfunc(sym, s[0], s[1])
}

# The program itself, which is where the C library it was linked against
# lives: malloc, free and memcpy are ordinary C functions, so the memory a C
# call needs is not a thing the language has to grow.
self = dlopen(null)

mallocFn = if failed(self) { self } else { Func(self.malloc, "void *malloc(size_t n)") }
freeFn = if failed(self) { self } else { Func(self.free, "void free(void *p)") }
memcpyFn = if failed(self) { self } else { Func(self.memcpy, "void *memcpy(void *dst, const void *src, size_t n)") }
strlenFn = if failed(self) { self } else { Func(self.strlen, "size_t strlen(const char *s)") }

# Alloc returns n bytes of memory C owns. Unlike bytes(n), the collector knows
# nothing about it and will not free it: that is Free, and forgetting to call
# it leaks.
Alloc = fn(n) {
	if failed(mallocFn) {
		return error("ffi: no C library here: {mallocFn}")
	}
	if n <= 0 {
		return error("ffi: Alloc wants a size, got {n}")
	}

	p = mallocFn(n)
	if p == null {
		return error("ffi: out of memory asking for {n} bytes")
	}
	return p
}

# Free gives back what Alloc returned.
Free = fn(p) {
	if failed(freeFn) {
		return error("ffi: no C library here: {freeFn}")
	}
	freeFn(p)
	return null
}

# Write copies data, a string or bytes, into memory at p, which is what fills
# a buffer a C function handed back.
Write = fn(p, data) {
	if failed(memcpyFn) {
		return error("ffi: no C library here: {memcpyFn}")
	}
	if p == null {
		return error("ffi: Write to a null pointer")
	}

	if type(data) != "bytes" {
		if failed(data = bytes(string(data))) {
			return data
		}
	}
	memcpyFn(p, data, len(data))
	return len(data)
}

# Read returns n bytes copied out of the pointer p, which is bytes(p, n) under
# another name, here so that the module reads as one thing.
Read = fn(p, n) { bytes(p, n) }

# String returns the C string at p, read up to its NUL and copied into tau.
String = fn(p) {
	if failed(strlenFn) {
		return error("ffi: no C library here: {strlenFn}")
	}
	if p == null {
		return null
	}
	return string(bytes(p, strlenFn(p)))
}

# Lib opens a shared library by the name it has on this system, so that a
# program that wants the maths library says "m" rather than the file name of
# one machine:
#
#	libm = ffi.Lib("m")           # libm.so.6 here, libm.dylib elsewhere
#	libc = ffi.Lib("c")
#
# A name with a separator or an extension in it is a path and is opened as it
# stands. Everything else is tried in the shapes this system uses, and if none
# of them opens, the error says what was tried.
#
# ponytail: the candidates are a list, not a query to the loader. glibc keeps
# the real library behind a version suffix and the unversioned name is a
# linker script that dlopen refuses, which is why libm.so.6 is in the list; a
# machine whose suffix is not there needs the path spelled out. Reading the
# ldconfig cache is the fix if that ever bites.
Lib = fn(name) {
	name = string(name)

	if isPath(name) {
		return dlopen(name)
	}

	tried = candidates(name)
	for i = 0; i < len(tried); ++i {
		h = dlopen(tried[i])

		if !failed(h) {
			return h
		}
	}
	names = strings.Join(tried, ", ")
	return error("ffi: no library named \"{name}\" here, tried {names}")
}

# isPath reports whether a name is already the name of a file rather than the
# stem of one.
isPath = fn(name) {
	if strings.Contains(name, "/") {
		return true
	}
	if strings.Contains(name, ".so") {
		return true
	}
	if strings.Contains(name, ".dylib") {
		return true
	}
	return strings.Contains(name, ".dll")
}

# candidates returns the file names a bare library name may have on this
# system, in the order to try them.
candidates = fn(name) {
	os = runtime.OS()

	if os == "windows" {
		return [name + ".dll", "lib" + name + ".dll"]
	}
	if os == "darwin" {
		return ["lib" + name + ".dylib", name + ".dylib"]
	}

	# The versioned names first: on glibc the unversioned one is a linker
	# script, which dlopen will not open.
	return [
		"lib" + name + ".so.6",
		"lib" + name + ".so.1",
		"lib" + name + ".so",
		name + ".so"
	]
}

# Bind returns an object with one function per signature, named the way the
# signature names it, which is the short way to take a library whose names are
# the ones you want to call:
#
#	m = ffi.Bind("libm.so.6", [
#		"double pow(double, double)",
#		"double sqrt(double)",
#	])
#	m.pow(2.0, 10.0)
#
# The first argument is a library: a handle from dlopen, or the name of one,
# which is opened here. Nothing else is done to it - a module that wants its
# own names, its own error handling or a wrapper around a call writes them out
# one by one with Func, which is what stdlib/math.tau does.
Bind = fn(lib, signatures) {
	# A name rather than a handle: open it the way Lib does, so that the usual
	# case is one call and not two.
	if type(lib) == "string" {
		if failed(lib = Lib(lib)) {
			return lib
		}
	}
	if type(lib) != "native" {
		return error("ffi: Bind wants a library or its name, got {type(lib)}")
	}

	out = new()

	for i = 0; i < len(signatures); ++i {
		if failed(s = Sig(signatures[i])) {
			return s
		}
		if s[2] == "" {
			return error("ffi: \"{signatures[i]}\" has no name to bind it to")
		}

		if failed(f = cfunc(lib[s[2]], s[0], s[1])) {
			return error("ffi: {s[2]}: {f}")
		}
		out[s[2]] = f
	}

	return out
}
