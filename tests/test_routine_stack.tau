testing = import("testing")

# A tau routine call is an expression like any other: it has to leave the stack
# the way it found it. When it did not, every spawn left its arguments behind
# and a loop of a few thousand of them ran the stack pointer past the end of
# the VM stack, which is 2048 slots deep.

work = fn(a, b, done) {
	send(done, a + b)
}

testing.Main([
		["starting routines in a loop does not grow the caller's stack", fn(t) {
				done = pipe(1)
				total = 0

				for i = 0; i < 5000; ++i {
					tau work(i, 1, done)
					total = total + recv(done)
				}

				# Every routine sends back i + 1, so the whole loop sums 1..5000.
				t.AssertEq(total, 12502500)
		}]
])
