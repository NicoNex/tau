strings = import("strings")
println(strings.Count("banana", "na"), strings.Count("aaa", "a"))
println(strings.Index("hello world", "world"), strings.LastIndex("go gopher go", "go"))
println(strings.LastIndexAny("hello", "lo"), strings.Contains("hello", "ell"))
println(strings.Join(["a","b","c"], ", "), strings.Repeat("ab", 3), strings.Reverse("tau"))
println(strings.Split("a,b,c", ","), strings.Fields("  a  b  "))
println(strings.ToUpper("tau"), strings.ToLower("TAU"), strings.TrimSpace("  x  "))
println(strings.HasPrefix("golang", "go"), strings.HasSuffix("golang", "ng"))
println(strings.ReplaceAll("a-b-c", "-", "+"))
big = strings.Repeat("x", 50000)
println("repeat len:", len(big))
