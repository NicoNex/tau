# net - TCP and UDP sockets, in the shape of Go's net package.
#
# Everything goes through syscall, there is no dependency on the C library of
# the host. Addresses are written "host:port", an empty host meaning every
# interface.

syscall = import("syscall")
strconv = import("strconv")

bufsize = 4096

# JoinHostPort builds an address out of a host and a port.
JoinHostPort = fn(host, port) { "{host}:{string(port)}" }

# SplitHostPort returns an object with Host and Port, or an error if the
# address carries no port. The last colon wins, so IPv6 forms survive.
SplitHostPort = fn(hostport) {
	colon = -1
	for i = len(hostport) - 1; i >= 0; --i {
		if hostport[i] == ":" {
			colon = i
			break
		}
	}

	if colon == -1 {
		return error("net: missing port in address \"{hostport}\"")
	}

	if failed(port = strconv.Atoi(slice(hostport, colon + 1, len(hostport)))) {
		return error("net: invalid port in address \"{hostport}\"")
	}

	out = new()
	out.Host = slice(hostport, 0, colon)
	out.Port = port
	return out
}

# sockaddr turns an address into the bytes bind and connect want.
sockaddr = fn(address) {
	if failed(hp = SplitHostPort(address)) {
		return hp
	}
	return syscall.SockaddrIn(hp.Host, hp.Port)
}

# newConn wraps an open socket.
newConn = fn(fd, raddr) {
	conn = new()
	conn.fd = fd
	conn.RemoteAddr = raddr

	# Read returns up to n bytes, or an empty bytes value when the other end
	# has closed the connection.
	conn.Read = fn(n) {
		if n == null {
			n = bufsize
		}

		buf = bytes(n)
		if failed(read = syscall.Recv(conn.fd, buf, n, 0)) {
			return read
		}
		return slice(buf, 0, read)
	}

	# Write sends a string or bytes and returns how many bytes went out.
	conn.Write = fn(data) {
		if type(data) != "bytes" {
			if failed(data = bytes(string(data))) {
				return data
			}
		}
		return syscall.Send(conn.fd, data, len(data), 0)
	}

	conn.Close = fn() { syscall.Close(conn.fd) }

	# SetTimeout gives up on a read or a write after ms milliseconds.
	conn.SetTimeout = fn(ms) {
		tv = syscall.Timeval(ms)
		syscall.Setsockopt(conn.fd, syscall.SOL_SOCKET, syscall.SO_RCVTIMEO, tv, len(tv))
		return syscall.Setsockopt(conn.fd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, tv, len(tv))
	}

	return conn
}

# Dial connects to an address. Network is "tcp" or "udp".
Dial = fn(network, address) {
	socktype = if network == "udp" { syscall.SOCK_DGRAM } else { syscall.SOCK_STREAM }

	if failed(sa = sockaddr(address)) {
		return sa
	}
	if failed(fd = syscall.Socket(syscall.AF_INET, socktype, 0)) {
		return fd
	}
	if failed(err = syscall.Connect(fd, sa, len(sa))) {
		syscall.Close(fd)
		return err
	}

	return newConn(fd, address)
}

# Listen returns a listener accepting connections on address.
Listen = fn(network, address) {
	if failed(sa = sockaddr(address)) {
		return sa
	}
	if failed(fd = syscall.Socket(syscall.AF_INET, syscall.SOCK_STREAM, 0)) {
		return fd
	}

	# Without this a restarted server can't bind again until the kernel
	# releases the port.
	one = syscall.Int32(1)
	syscall.Setsockopt(fd, syscall.SOL_SOCKET, syscall.SO_REUSEADDR, one, len(one))

	if failed(err = syscall.Bind(fd, sa, len(sa))) {
		syscall.Close(fd)
		return err
	}
	if failed(err = syscall.Listen(fd, syscall.SOMAXCONN)) {
		syscall.Close(fd)
		return err
	}

	ln = new()
	ln.fd = fd

	# The address the kernel actually bound: with a port of 0 it picks a free
	# one, and the caller learns which through ln.Addr. Falls back to what was
	# asked for if the lookup fails.
	name = bytes(syscall.SockaddrInSize())
	namelen = syscall.Int32(syscall.SockaddrInSize())
	if failed(syscall.Getsockname(fd, name, namelen)) {
		ln.Addr = address
	} else {
		ln.Addr = JoinHostPort(syscall.SockaddrIP(name), syscall.SockaddrPort(name))
	}

	# Accept waits for the next connection.
	ln.Accept = fn() {
		peer = bytes(syscall.SockaddrInSize())
		size = syscall.Int32(syscall.SockaddrInSize())

		if failed(cfd = syscall.Accept(ln.fd, peer, size)) {
			return cfd
		}
		return newConn(cfd, JoinHostPort(syscall.SockaddrIP(peer), syscall.SockaddrPort(peer)))
	}

	ln.Close = fn() { syscall.Close(ln.fd) }

	return ln
}

# ListenPacket returns a UDP socket bound to address.
ListenPacket = fn(network, address) {
	if failed(sa = sockaddr(address)) {
		return sa
	}
	if failed(fd = syscall.Socket(syscall.AF_INET, syscall.SOCK_DGRAM, 0)) {
		return fd
	}
	if failed(err = syscall.Bind(fd, sa, len(sa))) {
		syscall.Close(fd)
		return err
	}

	pc = new()
	pc.fd = fd
	pc.Addr = address

	# ReadFrom returns an object with Data and Addr, the sender of the packet.
	pc.ReadFrom = fn(n) {
		if n == null {
			n = bufsize
		}

		buf = bytes(n)
		from = bytes(syscall.SockaddrInSize())
		size = syscall.Int32(syscall.SockaddrInSize())

		if failed(read = syscall.Recvfrom(pc.fd, buf, n, 0, from, size)) {
			return read
		}

		out = new()
		out.Data = slice(buf, 0, read)
		out.Addr = JoinHostPort(syscall.SockaddrIP(from), syscall.SockaddrPort(from))
		return out
	}

	# WriteTo sends a packet to address.
	pc.WriteTo = fn(data, address) {
		if type(data) != "bytes" {
			if failed(data = bytes(string(data))) {
				return data
			}
		}
		if failed(sa = sockaddr(address)) {
			return sa
		}
		return syscall.Sendto(pc.fd, data, len(data), 0, sa, len(sa))
	}

	pc.Close = fn() { syscall.Close(pc.fd) }

	return pc
}

# ParseIP reports whether s is a valid dotted IPv4 address, returning it.
ParseIP = fn(s) {
	parts = 0
	start = 0
	i = 0

	for i <= len(s) {
		if i == len(s) || s[i] == "." {
			if failed(n = strconv.Atoi(slice(s, start, i))) {
				return error("net: invalid IP address \"{s}\"")
			}
			if n < 0 || n > 255 {
				return error("net: invalid IP address \"{s}\"")
			}
			++parts
			start = i + 1
		}
		++i
	}

	if parts != 4 {
		return error("net: invalid IP address \"{s}\"")
	}
	return s
}

# LookupPort returns the port of a well known service, or the number itself.
LookupPort = fn(network, service) {
	ports = {
		"http": 80,
		"https": 443,
		"ftp": 21,
		"ssh": 22,
		"smtp": 25,
		"dns": 53
	}

	if ports[service] != null {
		return ports[service]
	}
	return strconv.Atoi(service)
}
