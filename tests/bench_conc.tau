# concurrency: spawn routines, fan results through a pipe
worker = fn(p, base) {
	sum = 0
	for i = 0; i < 50000; ++i {
		sum = sum + (base + i)
	}
	send(p, sum)
}

p = pipe()
n = 8
for w = 0; w < n; ++w {
	tau worker(p, w * 1000)
}

total = 0
for i = 0; i < n; ++i {
	total = total + recv(p)
}
println(total)
