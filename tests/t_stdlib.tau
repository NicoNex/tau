list = import("list")
maps = import("maps")
buffer = import("buffer")
time = import("time")
cmp = import("cmp")

# list
xs = [5, 3, 9, 1, 3]
println(list.Map(xs, fn(x) { x * 2 }))
println(list.Filter(xs, fn(x) { x > 3 }))
println(list.Reduce(xs, 0, fn(a, b) { a + b }))
println(list.Sort(xs, null), "orig:", xs)
println(list.Sort(["pera", "mela", "kiwi"], null))
println(list.Sort(xs, fn(a, b) { b < a }))
println(list.Index(xs, 9), list.Contains(xs, 42), list.Reverse(xs))
println(list.Range(0, 5), list.Join(["a","b","c"], "-"))
println(list.Find(xs, fn(x) { x > 4 }))

# maps
m = {"a": 1, "b": 2}
println(maps.Has(m, "a"), maps.Has(m, "z"), maps.Get(m, "z", 42))
println(maps.Values(m), maps.Len(m))
println(maps.Merge(m, {"b": 9, "c": 3}))

# buffer
b = buffer.Builder()
for i = 0; i < 5; ++i { b.Write("x{i}") }
println(b.String(), b.Len())

buf = buffer.Buffer()
buf.Write("hello ")
buf.Write(bytes("world"))
println(buf.Len(), string(buf.Read(5)), buf.String())

# time
t0 = time.Mono()
time.Sleep(80)
d = time.Since(t0)
println("slept:", d >= 80 && d < 400, "unix ok:", time.Unix() > 1700000000)
println("measure:", time.Measure(fn() { time.Sleep(50) }) >= 50)
