# syscall.tau - Low-level system call interface for Tau
# Provides a cross-platform abstraction layer for system calls
# Similar to Go's syscall package

ffi = import("ffi")

# The library is looked up next to the installed stdlib, dlopen() falls back
# to ~/.local/lib/tau and /lib/tau when the relative path doesn't exist.
lib = dlopen("libsyscall.so")

# Every call is declared, so that a result comes back the width it really has
# rather than as a machine word to be read with int(x, 64) - and forgetting
# the 64 truncated it to an int of C, which is what a size or a millisecond
# does not fit in.
sys = ffi.Bind(lib, [
	"int64_t sys_open(const char *path, int64_t flags, int64_t mode)",
	"int64_t sys_close(int64_t fd)",
	"int64_t sys_read(int64_t fd, void *buf, int64_t count)",
	"int64_t sys_write(int64_t fd, const void *buf, int64_t count)",
	"int64_t sys_lseek(int64_t fd, int64_t offset, int64_t whence)",
	"int64_t sys_unlink(const char *path)",
	"int64_t sys_mkdir(const char *path, int64_t mode)",
	"int64_t sys_rmdir(const char *path)",
	"int64_t sys_chmod(const char *path, int64_t mode)",
	"int64_t sys_access(const char *path, int64_t mode)",
	"int64_t sys_socket(int64_t domain, int64_t type, int64_t protocol)",
	"int64_t sys_bind(int64_t sockfd, const void *addr, int64_t addrlen)",
	"int64_t sys_listen(int64_t sockfd, int64_t backlog)",
	"int64_t sys_accept(int64_t sockfd, void *addr, void *addrlen)",
	"int64_t sys_connect(int64_t sockfd, const void *addr, int64_t addrlen)",
	"int64_t sys_getsockname(int64_t sockfd, void *addr, void *addrlen)",
	"int64_t sys_send(int64_t sockfd, const void *buf, int64_t len, int64_t flags)",
	"int64_t sys_recv(int64_t sockfd, void *buf, int64_t len, int64_t flags)",
	"int64_t sys_sendto(int64_t sockfd, const void *buf, int64_t len, int64_t flags, const void *dest_addr, int64_t addrlen)",
	"int64_t sys_recvfrom(int64_t sockfd, void *buf, int64_t len, int64_t flags, void *src_addr, void *addrlen)",
	"int64_t sys_setsockopt(int64_t sockfd, int64_t level, int64_t optname, const void *optval, int64_t optlen)",
	"int64_t sys_getsockopt(int64_t sockfd, int64_t level, int64_t optname, void *optval, void *optlen)",
	"int64_t sys_shutdown(int64_t sockfd, int64_t how)",
	"uint16_t sys_htons(uint16_t hostshort)",
	"uint16_t sys_ntohs(uint16_t netshort)",
	"uint32_t sys_htonl(uint32_t hostlong)",
	"uint32_t sys_ntohl(uint32_t netlong)",
	"uint32_t sys_inet_addr(const char *cp)",
	"int64_t sys_sockaddr_in(void *buf, const char *ip, int64_t port)",
	"int64_t sys_sockaddr_in_size()",
	"int64_t sys_sockaddr_port(const void *buf)",
	"int64_t sys_sockaddr_ip(const void *buf, void *out, int64_t outlen)",
	"int64_t sys_int32(void *buf, int64_t v)",
	"int64_t sys_int32_size()",
	"int64_t sys_timeval(void *buf, int64_t ms)",
	"int64_t sys_timeval_size()",
	"int64_t sys_time_unix()",
	"int64_t sys_time_ms()",
	"int64_t sys_time_mono_ms()",
	"int64_t sys_sleep_ms(int64_t ms)",
	"int64_t sys_strerror(int64_t err, void *out, int64_t outlen)",
	"int64_t sys_errno()",
	"void sys_set_errno(int64_t err)",
	"int64_t sys_getenv(const char *name, void *out, int64_t outlen)",
	"int64_t sys_setenv(const char *name, const char *value, int64_t overwrite)",
	"int64_t sys_unsetenv(const char *name)",
	"int64_t sys_stat_size(const char *path)",
	"int64_t sys_stat_mode(const char *path)",
	"int64_t sys_stat_mtime(const char *path)",
	"int64_t sys_stat_isdir(const char *path)",
	"int64_t sys_rename(const char *from, const char *to)",
	"int64_t sys_getcwd(void *out, int64_t outlen)",
	"int64_t sys_chdir(const char *path)",
	"int64_t sys_opendir(const char *path)",
	"int64_t sys_readdir(int64_t dir, void *out, int64_t outlen)",
	"int64_t sys_closedir(int64_t dir)",
	"int64_t sys_tz_offset(int64_t t)",
	"int64_t sys_tz_name(int64_t t, void *out, int64_t outlen)",
	"int64_t sys_spawn_status(void)",
	"int64_t sys_spawn(const void *blob, int64_t bloblen, int64_t nargs, const void *in, int64_t inlen, void *out, int64_t outcap, int64_t flags)"
])

# ========== Error Handling ==========

Errno = fn() { sys.sys_errno() }
SetErrno = fn(err) { sys.sys_set_errno(err) }

# Strerror returns the message of an errno value.
Strerror = fn(err) {
	buf = bytes(256)
	n = sys.sys_strerror(err, buf, 256)
	return string(slice(buf, 0, n))
}

# Error builds an error for a failed call, with the message of the errno.
Error = fn(what) {
	err = Errno()
	return error("{what}: {Strerror(err)} (errno {err})")
}

# ========== File Operation Constants ==========

# open() flags - Linux/macOS values (POSIX)
O_RDONLY = 0x0000
O_WRONLY = 0x0001
O_RDWR = 0x0002
O_CREAT = 0x0040
O_EXCL = 0x0080
O_TRUNC = 0x0200
O_APPEND = 0x0400
O_NONBLOCK = 0x0800
O_SYNC = 0x1000

# File permissions
S_IRWXU = 0x01C0 # User: rwx
S_IRUSR = 0x0100 # User: r--
S_IWUSR = 0x0080 # User: -w-
S_IXUSR = 0x0040 # User: --x
S_IRWXG = 0x0038 # Group: rwx
S_IRGRP = 0x0020 # Group: r--
S_IWGRP = 0x0010 # Group: -w-
S_IXGRP = 0x0008 # Group: --x
S_IRWXO = 0x0007 # Other: rwx
S_IROTH = 0x0004 # Other: r--
S_IWOTH = 0x0002 # Other: -w-
S_IXOTH = 0x0001 # Other: --x

# lseek() whence
SEEK_SET = 0
SEEK_CUR = 1
SEEK_END = 2

# access() mode
F_OK = 0 # Test for existence
X_OK = 1 # Test for execute permission
W_OK = 2 # Test for write permission
R_OK = 4 # Test for read permission

# ========== Network Constants ==========

# Address families
AF_INET = 2 # IPv4
AF_INET6 = 10 # IPv6
AF_UNIX = 1 # Unix domain sockets

# Socket types
SOCK_STREAM = 1 # TCP
SOCK_DGRAM = 2 # UDP
SOCK_RAW = 3 # Raw socket

# Protocols
IPPROTO_IP = 0
IPPROTO_TCP = 6
IPPROTO_UDP = 17

# Socket options - level
SOL_SOCKET = 1

# Socket options - names
SO_REUSEADDR = 2
SO_REUSEPORT = 15
SO_KEEPALIVE = 9
SO_BROADCAST = 6
SO_LINGER = 13
SO_RCVBUF = 8
SO_SNDBUF = 7
SO_RCVTIMEO = 20
SO_SNDTIMEO = 21

# shutdown() how
SHUT_RD = 0
SHUT_WR = 1
SHUT_RDWR = 2

# Listen backlog
SOMAXCONN = 128

# The error numbers live in the errno module, which lists them all:
#
#	errno = import("errno")
#	if syscall.Errno() == errno.EAGAIN { ... }

# ========== File Operations ==========

Open = fn(path, flags, mode) {
	result = sys.sys_open(path, flags, mode)
	if result < 0 {
		return error("open failed: errno {Errno()}")
	}
	return result
}

Close = fn(fd) {
	result = sys.sys_close(fd)
	if result < 0 {
		return error("close failed: errno {Errno()}")
	}
	return result
}

Read = fn(fd, buf, count) {
	result = sys.sys_read(fd, buf, count)
	if result < 0 {
		return error("read failed: errno {Errno()}")
	}
	return result
}

Write = fn(fd, buf, count) {
	result = sys.sys_write(fd, buf, count)
	if result < 0 {
		return error("write failed: errno {Errno()}")
	}
	return result
}

Lseek = fn(fd, offset, whence) {
	result = sys.sys_lseek(fd, offset, whence)
	if result < 0 {
		return error("lseek failed: errno {Errno()}")
	}
	return result
}

Unlink = fn(path) {
	result = sys.sys_unlink(path)
	if result < 0 {
		return error("unlink failed: errno {Errno()}")
	}
	return result
}

Mkdir = fn(path, mode) {
	result = sys.sys_mkdir(path, mode)
	if result < 0 {
		return error("mkdir failed: errno {Errno()}")
	}
	return result
}

Rmdir = fn(path) {
	result = sys.sys_rmdir(path)
	if result < 0 {
		return error("rmdir failed: errno {Errno()}")
	}
	return result
}

Chmod = fn(path, mode) {
	result = sys.sys_chmod(path, mode)
	if result < 0 {
		return error("chmod failed: errno {Errno()}")
	}
	return result
}

Access = fn(path, mode) {
	result = sys.sys_access(path, mode)
	if result < 0 {
		return error("access failed: errno {Errno()}")
	}
	return result
}

# ========== Network Operations ==========

Socket = fn(domain, socktype, protocol) {
	result = sys.sys_socket(domain, socktype, protocol)
	if result < 0 {
		return error("socket failed: errno {Errno()}")
	}
	return result
}

Bind = fn(sockfd, addr, addrlen) {
	result = sys.sys_bind(sockfd, addr, addrlen)
	if result < 0 {
		return error("bind failed: errno {Errno()}")
	}
	return result
}

Listen = fn(sockfd, backlog) {
	result = sys.sys_listen(sockfd, backlog)
	if result < 0 {
		return error("listen failed: errno {Errno()}")
	}
	return result
}

Accept = fn(sockfd, addr, addrlen) {
	result = sys.sys_accept(sockfd, addr, addrlen)
	if result < 0 {
		return error("accept failed: errno {Errno()}")
	}
	return result
}

Getsockname = fn(sockfd, addr, addrlen) {
	if sys.sys_getsockname(sockfd, addr, addrlen) < 0 {
		return error("getsockname failed: errno {Errno()}")
	}
	return null
}

Connect = fn(sockfd, addr, addrlen) {
	result = sys.sys_connect(sockfd, addr, addrlen)
	if result < 0 {
		return error("connect failed: errno {Errno()}")
	}
	return result
}

Send = fn(sockfd, buf, len, flags) {
	result = sys.sys_send(sockfd, buf, len, flags)
	if result < 0 {
		return error("send failed: errno {Errno()}")
	}
	return result
}

Recv = fn(sockfd, buf, len, flags) {
	result = sys.sys_recv(sockfd, buf, len, flags)
	if result < 0 {
		return error("recv failed: errno {Errno()}")
	}
	return result
}

Sendto = fn(sockfd, buf, len, flags, dest_addr, addrlen) {
	result = sys.sys_sendto(sockfd, buf, len, flags, dest_addr, addrlen)
	if result < 0 {
		return error("sendto failed: errno {Errno()}")
	}
	return result
}

Recvfrom = fn(sockfd, buf, len, flags, src_addr, addrlen) {
	result = sys.sys_recvfrom(sockfd, buf, len, flags, src_addr, addrlen)
	if result < 0 {
		return error("recvfrom failed: errno {Errno()}")
	}
	return result
}

Setsockopt = fn(sockfd, level, optname, optval, optlen) {
	result = sys.sys_setsockopt(sockfd, level, optname, optval, optlen)
	if result < 0 {
		return error("setsockopt failed: errno {Errno()}")
	}
	return result
}

Getsockopt = fn(sockfd, level, optname, optval, optlen) {
	result = sys.sys_getsockopt(sockfd, level, optname, optval, optlen)
	if result < 0 {
		return error("getsockopt failed: errno {Errno()}")
	}
	return result
}

Shutdown = fn(sockfd, how) {
	result = sys.sys_shutdown(sockfd, how)
	if result < 0 {
		return error("shutdown failed: errno {Errno()}")
	}
	return result
}

# ========== Network Helper Functions ==========

Htons = fn(hostshort) { sys.sys_htons(hostshort) }
Ntohs = fn(netshort) { sys.sys_ntohs(netshort) }
Htonl = fn(hostlong) { sys.sys_htonl(hostlong) }
Ntohl = fn(netlong) { sys.sys_ntohl(netlong) }
InetAddr = fn(cp) { sys.sys_inet_addr(cp) }

# ========== Address Helpers ==========

# SockaddrInSize is the length of a sockaddr_in.
SockaddrInSize = fn() { sys.sys_sockaddr_in_size() }

# SockaddrIn returns a sockaddr_in filled for ip:port, ready for Bind,
# Connect and Sendto. An empty ip means "any address".
SockaddrIn = fn(ip, port) {
	buf = bytes(SockaddrInSize())
	sys.sys_sockaddr_in(buf, ip, port)
	return buf
}

# SockaddrPort returns the port stored in a sockaddr_in.
SockaddrPort = fn(sa) { sys.sys_sockaddr_port(sa) }

# SockaddrIP returns the dotted address stored in a sockaddr_in.
SockaddrIP = fn(sa) {
	buf = bytes(64)
	n = sys.sys_sockaddr_ip(sa, buf, 64)
	return string(slice(buf, 0, n))
}

# ========== Small Structs ==========

# Int32 returns the bytes of a native int32, for the calls that want a
# pointer to one.
Int32 = fn(n) {
	buf = bytes(sys.sys_int32_size())
	sys.sys_int32(buf, n)
	return buf
}

# Timeval returns the bytes of a struct timeval of ms milliseconds, for the
# timeout options of setsockopt.
Timeval = fn(ms) {
	buf = bytes(sys.sys_timeval_size())
	sys.sys_timeval(buf, ms)
	return buf
}

# ========== Time ==========

# TimeUnix returns the wall clock time in seconds since the Unix epoch.
TimeUnix = fn() { sys.sys_time_unix() }

# TimeMillis returns the wall clock time in milliseconds.
TimeMillis = fn() { sys.sys_time_ms() }

# TimeMono returns a monotonic timestamp in milliseconds.
TimeMono = fn() { sys.sys_time_mono_ms() }

# SleepMillis pauses the current tau routine for ms milliseconds.
SleepMillis = fn(ms) { sys.sys_sleep_ms(ms) }

# ========== Environment ==========

# Getenv returns the value of the variable name, or null when it isn't set.
Getenv = fn(name) {
	buf = bytes(4096)
	n = sys.sys_getenv(name, buf, 4096)
	if n < 0 {
		return null
	}
	return string(slice(buf, 0, n))
}

# Setenv sets the variable name to value, overwriting what was there.
Setenv = fn(name, value) {
	if sys.sys_setenv(name, value, 1) < 0 {
		return Error("setenv")
	}
	return null
}

# Unsetenv removes the variable name.
Unsetenv = fn(name) {
	if sys.sys_unsetenv(name) < 0 {
		return Error("unsetenv")
	}
	return null
}

# ========== File Metadata ==========

# The bits of a file mode, as returned by StatMode.
S_IFMT = 0170000
S_IFDIR = 0040000
S_IFREG = 0100000
S_IFLNK = 0120000

# StatSize returns the size of the file at path in bytes.
StatSize = fn(path) {
	n = sys.sys_stat_size(path)
	if n < 0 {
		return Error("stat {path}")
	}
	return n
}

# StatMode returns the mode of the file at path, permissions and type.
StatMode = fn(path) {
	n = sys.sys_stat_mode(path)
	if n < 0 {
		return Error("stat {path}")
	}
	return n
}

# StatMtime returns when the file at path was last modified, in seconds since
# the Unix epoch.
StatMtime = fn(path) {
	n = sys.sys_stat_mtime(path)
	if n < 0 {
		return Error("stat {path}")
	}
	return n
}

# StatIsDir reports whether path is a directory.
StatIsDir = fn(path) {
	n = sys.sys_stat_isdir(path)
	if n < 0 {
		return Error("stat {path}")
	}
	return n == 1
}

Rename = fn(from, to) {
	if sys.sys_rename(from, to) < 0 {
		return Error("rename {from}")
	}
	return null
}

# Getwd returns the working directory.
Getwd = fn() {
	buf = bytes(4096)
	n = sys.sys_getcwd(buf, 4096)
	if n < 0 {
		return Error("getcwd")
	}
	return string(slice(buf, 0, n))
}

Chdir = fn(path) {
	if sys.sys_chdir(path) < 0 {
		return Error("chdir {path}")
	}
	return null
}

# ========== Directories ==========

# Readdirnames returns the names inside the directory at path, "." and ".."
# included, the way the system hands them over.
Readdirnames = fn(path) {
	d = sys.sys_opendir(path)
	if d == 0 {
		return Error("opendir {path}")
	}

	names = []
	buf = bytes(4096)
	for {
		n = sys.sys_readdir(d, buf, 4096)
		if n < 0 {
			sys.sys_closedir(d)
			return names
		}
		names = append(names, string(slice(buf, 0, n)))
	}
}

# ========== Time Zone ==========

# TzOffset returns the seconds between local time and UTC at the instant sec,
# daylight saving included.
TzOffset = fn(sec) { sys.sys_tz_offset(sec) }

# TzName returns the abbreviation of the local zone at the instant sec.
TzName = fn(sec) {
	buf = bytes(64)
	n = sys.sys_tz_name(sec, buf, 64)
	if n < 0 {
		return Error("tzname")
	}
	return string(slice(buf, 0, n))
}

# ========== Processes ==========

# Spawn runs a program and waits for it. blob holds the program and its
# arguments one after the other, each one ended by a zero byte, and nargs says
# how many there are. What the program writes on its standard output is copied
# into out, and the return value is how many bytes it wrote in all: more than
# len(out) means the rest was thrown away.
#
# input is written to the standard input of the program, or null for nothing.
# The flags are 1 to fold standard error into the output and 2 to leave both
# alone, inherited from this process.
#
# The exit status is read with SpawnStatus after the call. See the exec module
# for the usual way to reach all this.
Spawn = fn(blob, nargs, input, out, flags) {
	inlen = if input == null { 0 } else { len(input) }
	outcap = if out == null { 0 } else { len(out) }

	n = sys.sys_spawn(blob, len(blob), nargs, input, inlen, out, outcap, flags)
	if n < 0 {
		return Error("spawn")
	}
	return n
}

# SpawnStatus is the exit status of the last Spawn: what the program passed to
# exit, or 128 plus the signal that killed it, or 127 when it wasn't found.
SpawnStatus = fn() { sys.sys_spawn_status() }
