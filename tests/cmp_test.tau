testing = import("testing")
cmp = import("cmp")
strconv = import("strconv")
errors = import("errors")

testing.Main([
	["cmp.Equal on scalars", fn(t) {
		t.AssertEq(cmp.Equal(1, 1), true)
		t.AssertEq(cmp.Equal("a", "a"), true)
		t.AssertEq(cmp.Equal(1, "1"), false)
	}],
	["cmp.Equal walks lists and maps", fn(t) {
		t.AssertEq(cmp.Equal([1, [2, 3]], [1, [2, 3]]), true)
		t.AssertEq(cmp.Equal([1, 2], [1, 3]), false)
		t.AssertEq(cmp.Equal({"a": 1}, {"a": 1}), true)
	}],
	["cmp.Compare orders", fn(t) {
		t.AssertEq(cmp.Compare(2, 3), -1)
		t.AssertEq(cmp.Compare(3, 3), 0)
		t.AssertEq(cmp.Compare("b", "a"), 1)
	}],
	["strconv parses and reports", fn(t) {
		t.AssertEq(strconv.Atoi("123"), 123)
		t.AssertEq(strconv.ParseInt("ff", 16), 255)
		t.AssertError(strconv.Atoi("abc"))
		t.AssertEq(strconv.FormatFloat(3.14159, 2), "3.14")
	}],
	["errors wrap and match", fn(t) {
		e = errors.Wrap(errors.New("no such file"), "opening config")
		t.AssertEq(errors.Is(e, "no such file"), true)
		t.AssertEq(errors.Is(e, "nope"), false)
	}]
])
