net = import("net")
time = import("time")

println("split:", net.SplitHostPort("127.0.0.1:8080").Host, net.SplitHostPort("localhost:80").Port)
println("split err:", type(net.SplitHostPort("nope")))
println("join:", net.JoinHostPort("10.0.0.1", 443))
println("parseip:", net.ParseIP("192.168.1.1"), type(net.ParseIP("999.1.1.1")), type(net.ParseIP("abc")))
println("port:", net.LookupPort("tcp", "https"), net.LookupPort("tcp", "8080"))

# TCP echo server on a tau routine
serve = fn(ln, done) {
	if failed(c = ln.Accept()) {
		send(done, "accept failed: {string(c)}")
		return null
	}
	data = c.Read(null)
	c.Write("echo: {string(data)}")
	c.Close()
	ln.Close()
	send(done, "served")
}

ln = net.Listen("tcp", "127.0.0.1:18099")
if failed(ln) { exit(string(ln), 1) }
done = pipe()
tau serve(ln, done)
time.Sleep(100)

c = net.Dial("tcp", "127.0.0.1:18099")
if failed(c) { exit(string(c), 1) }
c.Write("hello")
println("client got:", string(c.Read(null)))
c.Close()
println("server:", recv(done))
