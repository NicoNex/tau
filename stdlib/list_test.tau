testing = import("testing")
list = import("list")

testing.Main([
	["Map, Filter and Reduce", fn(t) {
		xs = [5, 3, 9, 1]
		t.AssertEq(list.Map(xs, fn(x) { x * 2 }), [10, 6, 18, 2])
		t.AssertEq(list.Filter(xs, fn(x) { x > 3 }), [5, 9])
		t.AssertEq(list.Reduce(xs, 0, fn(a, b) { a + b }), 18)
	}],
	["Sort leaves the original alone", fn(t) {
		xs = [5, 3, 9, 1, 3]
		t.AssertEq(list.Sort(xs, null), [1, 3, 3, 5, 9])
		t.AssertEq(xs, [5, 3, 9, 1, 3])
		t.AssertEq(list.Sort(["pera", "mela", "kiwi"], null), ["kiwi", "mela", "pera"])
		t.AssertEq(list.Sort(xs, fn(a, b) { b < a }), [9, 5, 3, 3, 1])
		t.AssertEq(list.Sort([], null), [])
	}],
	["Index, Contains and Find", fn(t) {
		xs = [5, 3, 9]
		t.AssertEq(list.Index(xs, 9), 2)
		t.AssertEq(list.Index(xs, 42), -1)
		t.AssertEq(list.Contains(xs, 3), true)
		t.AssertEq(list.Find(xs, fn(x) { x > 4 }), 5)
		t.AssertEq(list.Find(xs, fn(x) { x > 100 }), null)
	}],
	["Copy, Reverse, Range and Join", fn(t) {
		xs = [1, 2, 3]
		c = list.Copy(xs)
		c[0] = 99
		t.AssertEq(xs[0], 1)
		t.AssertEq(list.Reverse(xs), [3, 2, 1])
		t.AssertEq(list.Range(0, 5), [0, 1, 2, 3, 4])
		t.AssertEq(list.Range(0, 0), [])
		t.AssertEq(list.Join(["a", "b"], "-"), "a-b")
	}]
])
