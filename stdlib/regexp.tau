# regexp - regular expressions, in the shape of Go's regexp package.
#
# The pattern is parsed into a tree, compiled into a small program and run by
# a Pike VM: a Thompson NFA simulation carrying the capture slots along. Every
# thread advances one character at a time and there is at most one thread per
# instruction, so matching takes O(len(text) * len(program)) whatever the
# pattern, with none of the exponential blowups of a backtracking engine.
#
# Supported syntax:
#
#	.          any character except a newline
#	[abc]      class, with ranges and negation as [^a-z]
#	\d \w \s   digit, word and space classes, uppercase to negate
#	\b \B      word boundary
#	^ $        beginning and end of the text
#	x* x+ x?   repetition, append ? for the lazy form
#	x{n,m}     counted repetition, {n} and {n,} too
#	(x)        capturing group, (?:x) plain group
#	a|b        alternation

# --- syntax tree ---

nEmpty = 0
nChar = 1
nAny = 2
nClass = 3
nSeq = 4
nAlt = 5
nRepeat = 6
nGroup = 7
nBegin = 8
nEnd = 9
nWordB = 10
nNoWordB = 11

node = fn(t) {
	n = new()
	n.t = t
	return n
}

isDigit = fn(c) { c >= "0" && c <= "9" }
isWord = fn(c) { isDigit(c) || (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" }

# A class is a list of [lo, hi] ranges plus the negation flag.
classOf = fn(ranges, negated) {
	n = node(nClass)
	n.ranges = ranges
	n.negated = negated
	return n
}

# escapeClass returns the class an escape stands for, or null.
escapeClass = fn(c) {
	spaces = [[" ", " "], ["\t", "\t"], ["\n", "\n"], ["\r", "\r"], ["\v", "\v"], ["\f", "\f"]]
	words = [["a", "z"], ["A", "Z"], ["0", "9"], ["_", "_"]]

	if c == "d" { return classOf([["0", "9"]], false) }
	if c == "D" { return classOf([["0", "9"]], true) }
	if c == "w" { return classOf(words, false) }
	if c == "W" { return classOf(words, true) }
	if c == "s" { return classOf(spaces, false) }
	if c == "S" { return classOf(spaces, true) }
	return null
}

escapeChar = fn(c) {
	if c == "n" { return "\n" }
	if c == "t" { return "\t" }
	if c == "r" { return "\r" }
	if c == "v" { return "\v" }
	if c == "f" { return "\f" }
	return c
}

# --- parser ---
#
# The grammar, lowest precedence first:
#
#	alt    := seq ("|" seq)*
#	seq    := repeat*
#	repeat := atom ("*" | "+" | "?" | "{n,m}") "?"?
#	atom   := "(" alt ")" | "[" class "]" | "." | "^" | "$" | escape | char

parser = fn(pattern) {
	p = new()
	p.src = pattern
	p.i = 0
	p.ngroups = 0

	p.done = fn() { p.i >= len(p.src) }
	p.peek = fn() { if p.done() { "" } else { p.src[p.i] } }
	p.next = fn() {
		c = p.peek()
		++p.i
		return c
	}

	p.parseClass = fn() {
		negated = false
		if p.peek() == "^" {
			negated = true
			p.next()
		}

		ranges = []
		first = true

		# A ] right at the start is a literal one, as in Go.
		for !p.done() && (p.peek() != "]" || first) {
			first = false
			c = p.next()

			if c == "\\" && !p.done() {
				esc = p.next()
				cls = escapeClass(esc)

				if cls != null {
					if cls.negated {
						return error("regexp: \\{esc} is not allowed inside a class")
					}
					for k = 0; k < len(cls.ranges); ++k {
						ranges = append(ranges, cls.ranges[k])
					}
					continue
				}
				c = escapeChar(esc)
			}

			if p.peek() == "-" && p.i + 1 < len(p.src) && p.src[p.i+1] != "]" {
				p.next()
				hi = p.next()
				if hi == "\\" && !p.done() {
					hi = escapeChar(p.next())
				}
				if hi < c {
					return error("regexp: invalid character range {c}-{hi}")
				}
				ranges = append(ranges, [c, hi])
			} else {
				ranges = append(ranges, [c, c])
			}
		}

		if p.done() {
			return error("regexp: missing closing ]")
		}
		p.next()

		if len(ranges) == 0 {
			return error("regexp: empty character class")
		}
		return classOf(ranges, negated)
	}

	# parseCount reads {n}, {n,} and {n,m}.
	p.parseCount = fn() {
		digits = ""
		for !p.done() && isDigit(p.peek()) {
			digits = digits + p.next()
		}
		if len(digits) == 0 {
			return error("regexp: missing number in {}")
		}

		out = new()
		out.min = int(digits)
		out.max = out.min

		if p.peek() == "," {
			p.next()
			digits = ""
			for !p.done() && isDigit(p.peek()) {
				digits = digits + p.next()
			}
			out.max = if len(digits) == 0 { -1 } else { int(digits) }
		}

		if p.peek() != "}" {
			return error("regexp: missing closing }")
		}
		p.next()

		if out.max != -1 && out.max < out.min {
			return error("regexp: invalid repetition count")
		}
		return out
	}

	p.parseAtom = fn() {
		c = p.next()

		if c == "(" {
			capturing = true
			if p.peek() == "?" && p.i + 1 < len(p.src) && p.src[p.i+1] == ":" {
				p.next()
				p.next()
				capturing = false
			}

			index = 0
			if capturing {
				++p.ngroups
				index = p.ngroups
			}

			if failed(inner = p.parseAlt()) {
				return inner
			}
			if p.peek() != ")" {
				return error("regexp: missing closing )")
			}
			p.next()

			n = node(nGroup)
			n.sub = inner
			n.index = index
			return n
		}

		if c == "[" { return p.parseClass() }
		if c == "." { return node(nAny) }
		if c == "^" { return node(nBegin) }
		if c == "$" { return node(nEnd) }

		if c == "\\" {
			if p.done() {
				return error("regexp: trailing backslash")
			}

			esc = p.next()
			if esc == "b" { return node(nWordB) }
			if esc == "B" { return node(nNoWordB) }

			cls = escapeClass(esc)
			if cls != null {
				return cls
			}

			n = node(nChar)
			n.ch = escapeChar(esc)
			return n
		}

		if c == ")" {
			return error("regexp: unexpected )")
		}
		if c == "*" || c == "+" || c == "?" {
			return error("regexp: nothing to repeat before {c}")
		}

		n = node(nChar)
		n.ch = c
		return n
	}

	p.parseRepeat = fn() {
		if failed(atom = p.parseAtom()) {
			return atom
		}

		for true {
			c = p.peek()
			min = 0
			max = -1

			if c == "*" {
				p.next()
			} else if c == "+" {
				p.next()
				min = 1
			} else if c == "?" {
				p.next()
				max = 1
			} else if c == "{" {
				# A brace that isn't a count is a literal brace.
				save = p.i
				p.next()
				count = p.parseCount()

				if failed(count) {
					p.i = save
					return atom
				}
				min = count.min
				max = count.max
			} else {
				return atom
			}

			n = node(nRepeat)
			n.sub = atom
			n.min = min
			n.max = max
			n.lazy = false

			if p.peek() == "?" {
				p.next()
				n.lazy = true
			}
			atom = n
		}
	}

	p.parseSeq = fn() {
		items = []

		for !p.done() && p.peek() != "|" && p.peek() != ")" {
			if failed(item = p.parseRepeat()) {
				return item
			}
			items = append(items, item)
		}

		if len(items) == 0 { return node(nEmpty) }
		if len(items) == 1 { return items[0] }

		n = node(nSeq)
		n.items = items
		return n
	}

	p.parseAlt = fn() {
		if failed(left = p.parseSeq()) {
			return left
		}

		for p.peek() == "|" {
			p.next()
			if failed(right = p.parseSeq()) {
				return right
			}

			n = node(nAlt)
			n.left = left
			n.right = right
			left = n
		}

		return left
	}

	return p
}

# --- program ---
#
# opChar, opClass and opAny consume a character, everything else is an
# epsilon transition resolved while adding a thread to the current list.

opChar = 0
opClass = 1
opAny = 2
opSplit = 3
opJmp = 4
opSave = 5
opAssert = 6
opMatch = 7

# Assertions, checked against the position without consuming anything.
aBegin = 0
aEnd = 1
aWordB = 2
aNoWordB = 3

compiler = fn() {
	c = new()
	c.prog = []

	c.emit = fn(op) {
		ins = new()
		ins.op = op
		ins.x = 0
		ins.y = 0
		c.prog = append(c.prog, ins)
		return len(c.prog) - 1
	}

	c.at = fn(pc) { c.prog[pc] }
	c.here = fn() { len(c.prog) }

	c.compile = fn(n) {
		t = n.t

		if t == nEmpty {
			return null
		}

		if t == nChar {
			pc = c.emit(opChar)
			c.at(pc).ch = n.ch
			return null
		}

		if t == nAny {
			c.emit(opAny)
			return null
		}

		if t == nClass {
			pc = c.emit(opClass)
			c.at(pc).ranges = n.ranges
			c.at(pc).negated = n.negated
			return null
		}

		if t == nBegin || t == nEnd || t == nWordB || t == nNoWordB {
			pc = c.emit(opAssert)
			c.at(pc).x = if t == nBegin {
				aBegin
			} else if t == nEnd {
				aEnd
			} else if t == nWordB {
				aWordB
			} else {
				aNoWordB
			}
			return null
		}

		if t == nSeq {
			for i = 0; i < len(n.items); ++i {
				c.compile(n.items[i])
			}
			return null
		}

		if t == nGroup {
			if n.index == 0 {
				return c.compile(n.sub)
			}

			open = c.emit(opSave)
			c.at(open).x = n.index * 2
			c.compile(n.sub)
			close = c.emit(opSave)
			c.at(close).x = n.index * 2 + 1
			return null
		}

		if t == nAlt {
			# split L1, L2 ; L1: left ; jmp end ; L2: right ; end:
			split = c.emit(opSplit)
			c.at(split).x = c.here()
			c.compile(n.left)

			jmp = c.emit(opJmp)
			c.at(split).y = c.here()
			c.compile(n.right)
			c.at(jmp).x = c.here()
			return null
		}

		if t == nRepeat {
			return c.compileRepeat(n)
		}

		return null
	}

	# The mandatory copies are laid out one after the other, the optional
	# ones each guarded by a split.
	c.compileRepeat = fn(n) {
		for i = 0; i < n.min; ++i {
			c.compile(n.sub)
		}

		if n.max == -1 {
			if n.min == 0 {
				# star: split body, end ; body ; jmp split ; end:
				split = c.emit(opSplit)
				c.setSplit(split, c.here(), 0, n.lazy)
				c.compile(n.sub)

				jmp = c.emit(opJmp)
				c.at(jmp).x = split
				c.setSplitExit(split, c.here(), n.lazy)
				return null
			}

			# plus, after the mandatory copies: split body, end
			body = c.here()
			split = c.emit(opSplit)
			c.setSplit(split, c.here(), 0, n.lazy)
			c.compile(n.sub)

			jmp = c.emit(opJmp)
			c.at(jmp).x = split
			c.setSplitExit(split, c.here(), n.lazy)
			return null
		}

		# A bounded repetition: one guarded copy for every optional round.
		splits = []
		for i = n.min; i < n.max; ++i {
			split = c.emit(opSplit)
			c.setSplit(split, c.here(), 0, n.lazy)
			splits = append(splits, split)
			c.compile(n.sub)
		}

		end = c.here()
		for i = 0; i < len(splits); ++i {
			c.setSplitExit(splits[i], end, n.lazy)
		}
		return null
	}

	# A greedy split tries the body first, a lazy one the exit.
	c.setSplit = fn(pc, body, exit, lazy) {
		if lazy {
			c.at(pc).y = body
		} else {
			c.at(pc).x = body
		}
	}

	c.setSplitExit = fn(pc, exit, lazy) {
		if lazy {
			c.at(pc).x = exit
		} else {
			c.at(pc).y = exit
		}
	}

	return c
}

compileProgram = fn(tree, ngroups) {
	c = compiler()

	start = c.emit(opSave)
	c.at(start).x = 0
	c.compile(tree)
	end = c.emit(opSave)
	c.at(end).x = 1
	c.emit(opMatch)

	return c.prog
}

# --- Pike VM ---

inRanges = fn(ins, ch) {
	found = false

	for i = 0; i < len(ins.ranges); ++i {
		if ch >= ins.ranges[i][0] && ch <= ins.ranges[i][1] {
			found = true
			break
		}
	}

	return if ins.negated { !found } else { found }
}

assertHolds = fn(kind, text, pos) {
	if kind == aBegin {
		return pos == 0
	}
	if kind == aEnd {
		return pos == len(text)
	}

	before = pos > 0 && isWord(text[pos-1])
	after = pos < len(text) && isWord(text[pos])

	if kind == aWordB {
		return before != after
	}
	return before == after
}

copyCaps = fn(caps) {
	out = []
	for i = 0; i < len(caps); ++i {
		out = append(out, caps[i])
	}
	return out
}

# addThread follows the epsilon transitions and appends the threads that are
# waiting for a character. The order of insertion is the priority order, so
# the leftmost alternative wins like it does in Go.
addThread = fn(list, seen, pc, text, pos, caps, prog) {
	if seen[pc] {
		return list
	}
	seen[pc] = true

	ins = prog[pc]

	if ins.op == opJmp {
		return addThread(list, seen, ins.x, text, pos, caps, prog)
	}

	if ins.op == opSplit {
		list = addThread(list, seen, ins.x, text, pos, caps, prog)
		return addThread(list, seen, ins.y, text, pos, caps, prog)
	}

	if ins.op == opSave {
		saved = caps[ins.x]
		caps[ins.x] = pos
		list = addThread(list, seen, pc + 1, text, pos, caps, prog)
		caps[ins.x] = saved
		return list
	}

	if ins.op == opAssert {
		if !assertHolds(ins.x, text, pos) {
			return list
		}
		return addThread(list, seen, pc + 1, text, pos, caps, prog)
	}

	th = new()
	th.pc = pc
	th.caps = copyCaps(caps)
	return append(list, th)
}

newSeen = fn(n) {
	seen = []
	for i = 0; i < n; ++i {
		seen = append(seen, false)
	}
	return seen
}

# run tries to match starting exactly at pos, returning the capture slots or
# null. The threads are all advanced together, one character at a time.
run = fn(prog, text, pos, nslots) {
	caps = []
	for i = 0; i < nslots; ++i {
		caps = append(caps, -1)
	}

	clist = addThread([], newSeen(len(prog)), 0, text, pos, caps, prog)
	matched = null
	i = pos

	for true {
		if len(clist) == 0 {
			return matched
		}

		nlist = []
		seen = newSeen(len(prog))
		ch = if i < len(text) { text[i] } else { "" }

		for t = 0; t < len(clist); ++t {
			th = clist[t]
			ins = prog[th.pc]

			if ins.op == opMatch {
				# A thread of higher priority matched: the ones after it are
				# alternatives we no longer care about.
				matched = th.caps
				break
			}

			if i >= len(text) {
				continue
			}

			if ins.op == opChar && ch == ins.ch {
				nlist = addThread(nlist, seen, th.pc + 1, text, i + 1, th.caps, prog)
			} else if ins.op == opAny && ch != "\n" {
				nlist = addThread(nlist, seen, th.pc + 1, text, i + 1, th.caps, prog)
			} else if ins.op == opClass && inRanges(ins, ch) {
				nlist = addThread(nlist, seen, th.pc + 1, text, i + 1, th.caps, prog)
			}
		}

		if i >= len(text) {
			return matched
		}

		clist = nlist
		++i
	}

	return matched
}

# --- public API ---

makeRegexp = fn(pattern, tree, ngroups) {
	re = new()
	re.pattern = pattern
	re.ngroups = ngroups
	re.prog = compileProgram(tree, ngroups)
	re.nslots = (ngroups + 1) * 2

	re.String = fn() { re.pattern }

	# NumSubexp returns the number of capturing groups.
	re.NumSubexp = fn() { re.ngroups }

	# FindStringSubmatchIndex returns the index pairs of the leftmost match
	# and of its groups, null when there is no match.
	re.FindStringSubmatchIndex = fn(s) {
		for i = 0; i <= len(s); ++i {
			caps = run(re.prog, s, i, re.nslots)
			if caps != null {
				return caps
			}
		}
		return null
	}

	# FindStringIndex returns the start and the end of the leftmost match.
	re.FindStringIndex = fn(s) {
		caps = re.FindStringSubmatchIndex(s)
		return if caps == null { null } else { [caps[0], caps[1]] }
	}

	# FindString returns the text of the leftmost match, empty if there is none.
	re.FindString = fn(s) {
		idx = re.FindStringIndex(s)
		return if idx == null { "" } else { slice(s, idx[0], idx[1]) }
	}

	capsToStrings = fn(s, caps) {
		out = []
		for i = 0; i < len(caps); i = i + 2 {
			if caps[i] == -1 {
				out = append(out, null)
			} else {
				out = append(out, slice(s, caps[i], caps[i+1]))
			}
		}
		return out
	}

	# FindStringSubmatch returns the match and its groups. A group that took
	# no part in the match is null.
	re.FindStringSubmatch = fn(s) {
		caps = re.FindStringSubmatchIndex(s)
		return if caps == null { null } else { capsToStrings(s, caps) }
	}

	# MatchString reports whether s contains a match.
	re.MatchString = fn(s) { re.FindStringSubmatchIndex(s) != null }

	re.Match = fn(b) { re.MatchString(string(b)) }

	# allMatches returns the captures of every match, at most n when n >= 0.
	# It returns a list instead of taking a callback because a closure that
	# appends to a list of its enclosing scope would append to its own copy.
	re.allMatches = fn(s, n) {
		out = []
		pos = 0

		for pos <= len(s) {
			if n >= 0 && len(out) >= n {
				return out
			}

			caps = null
			i = pos
			for i <= len(s) {
				caps = run(re.prog, s, i, re.nslots)
				if caps != null {
					break
				}
				++i
			}
			if caps == null {
				return out
			}

			out = append(out, caps)

			# An empty match steps one character forward, otherwise the same
			# position would keep matching.
			pos = if caps[1] == caps[0] { caps[1] + 1 } else { caps[1] }
		}

		return out
	}

	nOrAll = fn(n) { if n == null { -1 } else { n } }

	# FindAllString returns up to n matches, all of them when n is -1.
	re.FindAllString = fn(s, n) {
		ms = re.allMatches(s, nOrAll(n))
		out = []

		for i = 0; i < len(ms); ++i {
			out = append(out, slice(s, ms[i][0], ms[i][1]))
		}
		return if len(out) == 0 { null } else { out }
	}

	re.FindAllStringIndex = fn(s, n) {
		ms = re.allMatches(s, nOrAll(n))
		out = []

		for i = 0; i < len(ms); ++i {
			out = append(out, [ms[i][0], ms[i][1]])
		}
		return if len(out) == 0 { null } else { out }
	}

	re.FindAllStringSubmatch = fn(s, n) {
		ms = re.allMatches(s, nOrAll(n))
		out = []

		for i = 0; i < len(ms); ++i {
			out = append(out, capsToStrings(s, ms[i]))
		}
		return if len(out) == 0 { null } else { out }
	}

	# ReplaceAllStringFunc replaces every match with what f returns for it.
	re.ReplaceAllStringFunc = fn(s, f) {
		ms = re.allMatches(s, -1)
		out = ""
		last = 0

		for i = 0; i < len(ms); ++i {
			out = out + slice(s, last, ms[i][0]) + f(slice(s, ms[i][0], ms[i][1]))
			last = ms[i][1]
		}

		return out + slice(s, last, len(s))
	}

	# ReplaceAllString replaces every match with repl.
	re.ReplaceAllString = fn(s, repl) { re.ReplaceAllStringFunc(s, fn(m) { repl }) }

	# Split slices s around every match, into at most n pieces when n >= 0.
	re.Split = fn(s, n) {
		limit = nOrAll(n)
		ms = re.allMatches(s, -1)
		out = []
		last = 0

		for i = 0; i < len(ms); ++i {
			if limit >= 0 && len(out) >= limit - 1 {
				break
			}
			out = append(out, slice(s, last, ms[i][0]))
			last = ms[i][1]
		}

		return append(out, slice(s, last, len(s)))
	}

	return re
}

# Compile parses a pattern and returns a Regexp, or an error.
Compile = fn(pattern) {
	p = parser(pattern)

	if failed(tree = p.parseAlt()) {
		return tree
	}
	if !p.done() {
		return error("regexp: unexpected {p.peek()}")
	}

	return makeRegexp(pattern, tree, p.ngroups)
}

# MustCompile is Compile, but it stops the program on an invalid pattern.
MustCompile = fn(pattern) {
	re = Compile(pattern)
	if failed(re) {
		exit(string(re), 1)
	}
	return re
}

# QuoteMeta returns a pattern that matches the literal text of s.
QuoteMeta = fn(s) {
	meta = "\\.+*?()|[]{}^$"
	out = ""

	for i = 0; i < len(s); ++i {
		for j = 0; j < len(meta); ++j {
			if s[i] == meta[j] {
				out = out + "\\"
				break
			}
		}
		out = out + s[i]
	}

	return out
}

# --- package level shortcuts ---

MatchString = fn(pattern, s) {
	re = Compile(pattern)
	if failed(re) {
		return re
	}
	return re.MatchString(s)
}

Match = fn(pattern, b) { MatchString(pattern, string(b)) }
