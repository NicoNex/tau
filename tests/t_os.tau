os = import("os")

path = "/tmp/tau_os_test.txt"
println("write:", os.WriteFile(path, "hello file\n"))
println("exists:", os.Exists(path), os.Exists("/tmp/nope_xyz"))
println("read:", os.ReadFileString(path))

f = os.Open(path, os.O_RDONLY, 0)
println("chunk:", string(f.Read(5)))
f.Close()

big = ""
for i = 0; i < 20000; ++i { big = big + "0123456789" }
os.WriteFile(path, big)
back = os.ReadFileString(path)
println("roundtrip:", len(back) == len(big), len(back))
println("remove:", os.Remove(path), "exists after:", os.Exists(path))
println("open missing:", type(os.Open("/nope/zzz", os.O_RDONLY, 0)))
