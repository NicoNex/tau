net = import("stdlib/net.tau")
print("Type of net: ")
print(type(net))
print("\n")

# Try to access Listen
print("Trying to access net.Listen:\n")
if net.Listen != null {
    print("net.Listen exists\n")
} else {
    print("net.Listen is null\n")
}

# Check what's in net
print("Keys in net:\n")
k = keys(net)
for i = 0; i < len(k); i += 1 {
    print(k[i])
    print("\n")
}
