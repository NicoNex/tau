#!/usr/bin/env tau

# Test concurrent execution with pipes (proper synchronization)

p = pipe(5)

worker = fn(id, pipe) {
    result = 0
    for i = 0; i < 1000; i = i + 1 {
        result = result + 1
    }
    send(pipe, result)
    println("Worker", id, "completed with result:", result)
}

# Spawn 5 concurrent workers
tau worker(1, p)
tau worker(2, p)
tau worker(3, p)
tau worker(4, p)
tau worker(5, p)

# Collect results
total = 0
for i = 0; i < 5; i = i + 1 {
    result = recv(p)
    total = total + result
}

println("Total from all workers:", total)
println("Expected: 5000")
