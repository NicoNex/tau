testing = import("testing")
cmp = import("cmp")

testing.Main([
		["Equal on scalars", fn(t) {
				t.AssertEq(cmp.Equal(1, 1), true)
				t.AssertEq(cmp.Equal("a", "a"), true)
				t.AssertEq(cmp.Equal(1, "1"), false)
				t.AssertEq(cmp.Equal(null, null), true)
			}],
		["Equal walks lists, maps and objects", fn(t) {
				t.AssertEq(cmp.Equal([1, [2, 3]], [1, [2, 3]]), true)
				t.AssertEq(cmp.Equal([1, 2], [1, 3]), false)
				t.AssertEq(cmp.Equal([1, 2], [1, 2, 3]), false)
				t.AssertEq(cmp.Equal({"a": 1}, {"a": 1}), true)
				t.AssertEq(cmp.Equal({"a": 1}, {"a": 2}), false)

				o1 = new()
				o1.x = 1
				o2 = new()
				o2.x = 1
				t.AssertEq(cmp.Equal(o1, o2), true)
			}],
		["Compare orders", fn(t) {
				t.AssertEq(cmp.Compare(2, 3), -1)
				t.AssertEq(cmp.Compare(3, 3), 0)
				t.AssertEq(cmp.Compare("b", "a"), 1)
			}],
		["Min and Max", fn(t) {
				t.AssertEq(cmp.Min(3, 1), 1)
				t.AssertEq(cmp.Max(3, 1), 3)
			}]
	])
