# time - clocks and pauses.
#
# Durations are milliseconds, whole numbers. Wall clock time is what a clock
# on the wall says and can jump backwards, the monotonic one only moves
# forward and is the one to measure with.

syscall = import("syscall")

Millisecond = 1
Second = 1000
Minute = 60000
Hour = 3600000

# Now returns the wall clock time in milliseconds since the Unix epoch.
Now = fn() { int(syscall.TimeMillis()) }

# Unix returns the wall clock time in whole seconds since the Unix epoch.
Unix = fn() { int(syscall.TimeUnix()) }

# Mono returns a monotonic timestamp in milliseconds. Only differences
# between two of these have a meaning.
Mono = fn() { int(syscall.TimeMono()) }

# Since returns the milliseconds elapsed since the monotonic timestamp t.
Since = fn(t) { Mono() - t }

# Sleep pauses the current tau routine for ms milliseconds.
Sleep = fn(ms) { syscall.SleepMillis(ms) }

# Measure returns the milliseconds taken by f().
Measure = fn(f) {
	start = Mono()
	f()
	return Since(start)
}

# ========== Dates ==========
#
# A date is UTC unless an offset says otherwise. Local takes the offset from
# the timezone database of the system, daylight saving included, so an hour
# in Rome is the hour in Rome.

Days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
Months = ["January", "February", "March", "April", "May", "June", "July",
	"August", "September", "October", "November", "December"]

# div is the integer division that rounds towards minus infinity, the one the
# calendar arithmetic below is written in terms of. Dividing two integers
# rounds towards zero, which is a different answer on the negative side, so
# the quotient is pushed down by one where the two disagree.
div = fn(a, b) {
	q = a / b
	if a % b != 0 && (a < 0) != (b < 0) {
		--q
	}
	return q
}

mod = fn(a, b) { a - div(a, b) * b }

# Date returns what the wall clock time sec, in seconds since the Unix epoch,
# stands for: Year, Month (1 to 12), Day, Hour, Minute, Second, the Weekday
# with Sunday as 0, and the YearDay starting at 1.
#
# The calendar arithmetic is the one Howard Hinnant wrote for chrono: days
# are counted from the first of March so that the leap day falls at the end
# of the year, where it does no harm.
Date = fn(sec) { DateIn(sec, 0) }

# DateIn is Date with a zone: offset is the seconds between that zone and
# UTC, 3600 for Rome in winter and 7200 in summer. The fields read as the
# clock on that wall reads, while Unix stays the instant it is.
DateIn = fn(sec, offset) {
	if offset == null {
		offset = 0
	}

	local = sec + offset
	days = div(local, 86400)
	rem = local - days * 86400

	z = days + 719468
	era = div(z, 146097)
	doe = z - era * 146097
	yoe = div(doe - div(doe, 1460) + div(doe, 36524) - div(doe, 146096), 365)
	y = yoe + era * 400
	doy = doe - (365 * yoe + div(yoe, 4) - div(yoe, 100))
	mp = div(5 * doy + 2, 153)
	d = doy - div(153 * mp + 2, 5) + 1
	m = if mp < 10 { mp + 3 } else { mp - 9 }
	if m <= 2 {
		++y
	}

	t = new()
	t.Unix = sec
	t.Offset = offset
	t.Year = y
	t.Month = m
	t.Day = d
	t.Hour = div(rem, 3600)
	t.Minute = mod(div(rem, 60), 60)
	t.Second = mod(rem, 60)
	t.Weekday = mod(days + 4, 7)
	t.YearDay = days - daysFromCivil(y, 1, 1) + 1
	return t
}

# LocalOffset is the offset of the local zone at the instant sec, or right
# now when sec is null.
LocalOffset = fn(sec) {
	if sec == null {
		sec = Unix()
	}
	return syscall.TzOffset(sec)
}

# LocalZone is the abbreviation of the local zone at that instant: CET, CEST.
LocalZone = fn(sec) {
	if sec == null {
		sec = Unix()
	}
	return syscall.TzName(sec)
}

# Local returns the date sec stands for where this machine is.
Local = fn(sec) { DateIn(sec, LocalOffset(sec)) }

# Now returns the local date of this instant.
NowLocal = fn() { Local(Unix()) }

# daysFromCivil is the number of days between the Unix epoch and the given
# date, the way back from Date.
daysFromCivil = fn(y, m, d) {
	if m <= 2 {
		--y
	}
	era = div(y, 400)
	yoe = y - era * 400
	mp = if m > 2 { m - 3 } else { m + 9 }
	doy = div(153 * mp + 2, 5) + d - 1
	doe = yoe * 365 + div(yoe, 4) - div(yoe, 100) + doy
	return era * 146097 + doe - 719468
}

# FromDate returns the seconds since the epoch of the given UTC date, the way
# back from Date.
FromDate = fn(year, month, day, hour, minute, second) {
	return daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}

# FromDateIn is FromDate in a zone: the date is read as the clock of that
# zone reads it, and the instant comes back in UTC.
FromDateIn = fn(year, month, day, hour, minute, second, offset) {
	if offset == null {
		offset = 0
	}
	return FromDate(year, month, day, hour, minute, second) - offset
}

# ========== Weeks ==========
#
# Weekday counts from Sunday, the way Go does. Where the week starts is a
# question of where you are: in Italy it is Monday, which is what ISOWeekday
# and the ISO week number below are about.

Sunday = 0
Monday = 1
Tuesday = 2
Wednesday = 3
Thursday = 4
Friday = 5
Saturday = 6

# ISOWeekday numbers the days from Monday as 1 to Sunday as 7.
ISOWeekday = fn(t) { if t.Weekday == 0 { 7 } else { t.Weekday } }

# IsWeekend reports whether the date falls on a Saturday or a Sunday.
IsWeekend = fn(t) { t.Weekday == Sunday || t.Weekday == Saturday }

# StartOfDay returns the instant the day of t begins, in its own zone.
StartOfDay = fn(t) {
	return FromDateIn(t.Year, t.Month, t.Day, 0, 0, 0, t.Offset)
}

# StartOfWeek returns the instant the week holding t begins, with first
# saying which day that is: Monday in most of Europe, Sunday elsewhere. With
# no first, Monday.
StartOfWeek = fn(t, first) {
	if first == null {
		first = Monday
	}

	back = mod(t.Weekday - first, 7)
	return StartOfDay(t) - back * 86400
}

# Week returns the number of the week holding t, counting from the first week
# that starts on a first day, with the days before it in week 0. It is what a
# calendar on a wall shows.
Week = fn(t, first) {
	if first == null {
		first = Monday
	}

	jan1 = DateIn(FromDateIn(t.Year, 1, 1, 0, 0, 0, t.Offset), t.Offset)
	lead = mod(first - jan1.Weekday, 7)
	if t.YearDay <= lead {
		return 0
	}
	return div(t.YearDay - lead - 1, 7) + 1
}

# ISOWeek returns the ISO 8601 year and week of t: weeks start on Monday and
# week 1 is the one holding the 4th of January, so the first days of January
# can belong to the last week of the year before.
ISOWeek = fn(t) {
	# The Thursday of this week decides which year the week belongs to.
	thursday = StartOfDay(t) + (4 - ISOWeekday(t)) * 86400
	th = DateIn(thursday, t.Offset)

	jan4 = DateIn(FromDateIn(th.Year, 1, 4, 0, 0, 0, t.Offset), t.Offset)
	firstWeek = StartOfWeek(jan4, Monday)

	return [th.Year, div(thursday - firstWeek, 604800) + 1]
}

# IsLeap reports whether the year has a 29th of February.
IsLeap = fn(y) { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

# pad writes n with at least width digits.
pad = fn(n, width) {
	s = string(n)
	for len(s) < width {
		s = "0" + s
	}
	return s
}

# Format writes t, a date from Date, in the given layout. The verbs are the
# ones of strftime, the handful that are worth having:
#
#	%Y year      %m month     %d day     %j day of the year
#	%H hour      %M minute    %S second
#	%b month name, short      %B month name
#	%a day name, short        %A day name
#	%z offset from UTC        %% a per cent sign
#
# With no layout the date is written as RFC 3339: 2006-01-02T15:04:05Z.
Format = fn(t, layout) {
	if layout == null {
		# RFC 3339: a Z for UTC, the offset for anywhere else.
		layout = if t.Offset == null || t.Offset == 0 { "%Y-%m-%dT%H:%M:%SZ" } else { "%Y-%m-%dT%H:%M:%S%z" }
	}

	out = ""
	for i = 0; i < len(layout); ++i {
		if layout[i] != "%" || i == len(layout) - 1 {
			out = out + layout[i]
			continue
		}

		++i
		out = out + verb(t, layout[i])
	}
	return out
}

# verb writes the one field of t a format verb stands for. An unknown verb is
# left as it was written, so that a mistake shows up in the output instead of
# disappearing.
verb = fn(t, c) {
	if c == "Y" { return pad(t.Year, 4) }
	if c == "m" { return pad(t.Month, 2) }
	if c == "d" { return pad(t.Day, 2) }
	if c == "H" { return pad(t.Hour, 2) }
	if c == "M" { return pad(t.Minute, 2) }
	if c == "S" { return pad(t.Second, 2) }
	if c == "j" { return pad(t.YearDay, 3) }
	if c == "B" { return Months[t.Month - 1] }
	if c == "b" { return slice(Months[t.Month - 1], 0, 3) }
	if c == "A" { return Days[t.Weekday] }
	if c == "a" { return slice(Days[t.Weekday], 0, 3) }
	if c == "z" { return offsetString(t.Offset) }
	if c == "%" { return "%" }
	return "%" + c
}

# offsetString writes a zone offset as RFC 3339 wants it: +01:00.
offsetString = fn(off) {
	if off == null {
		off = 0
	}

	sign = "+"
	if off < 0 {
		sign = "-"
		off = -off
	}
	return sign + pad(div(off, 3600), 2) + ":" + pad(mod(div(off, 60), 60), 2)
}

# Parse reads a date written as RFC 3339, "2006-01-02T15:04:05Z", and returns
# the seconds since the epoch. The time part may be left out.
Parse = fn(s) {
	if len(s) < 10 {
		return error("time: {s} is not a date")
	}

	num = fn(from, to) {
		part = slice(s, from, to)
		for i = 0; i < len(part); ++i {
			if part[i] < "0" || part[i] > "9" {
				return error("time: {s} is not a date")
			}
		}
		return int(part)
	}

	if failed(year = num(0, 4)) {
		return year
	}
	if failed(month = num(5, 7)) {
		return month
	}
	if failed(day = num(8, 10)) {
		return day
	}

	if len(s) < 19 {
		return FromDate(year, month, day, 0, 0, 0)
	}

	if failed(hour = num(11, 13)) {
		return hour
	}
	if failed(minute = num(14, 16)) {
		return minute
	}
	if failed(second = num(17, 19)) {
		return second
	}
	return FromDate(year, month, day, hour, minute, second)
}

# String writes the date of the wall clock time sec as RFC 3339.
String = fn(sec) { Format(Date(sec), null) }
