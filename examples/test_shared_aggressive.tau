#!/usr/bin/env tau

# Aggressive test: Parent GC runs multiple times while children work

make_large_list = fn() {
    result = []
    for i = 0; i < 1000; i = i + 1 {
        result = append(result, i)
    }
    return result
}

slow_worker = fn(lst, id, result_pipe) {
    # Work slowly to ensure parent GC runs
    sum = 0
    for iteration = 0; iteration < 10; iteration = iteration + 1 {
        for i = 0; i < len(lst); i = i + 1 {
            sum = sum + lst[i]
        }
    }
    send(result_pipe, sum)
    println("Worker", id, "done")
}

# Create list that will be shared
shared_list = make_large_list()
println("Created shared list with", len(shared_list), "elements")

p = pipe(2)

# Spawn workers
tau slow_worker(shared_list, 1, p)
tau slow_worker(shared_list, 2, p)

# Immediately drop reference to shared_list in parent
# and create tons of garbage to force GC
shared_list = null

println("Dropped parent reference, creating garbage...")
for i = 0; i < 2000; i = i + 1 {
    garbage = make_large_list()
    if i % 500 == 0 {
        println("  Created", i, "garbage lists...")
    }
}
println("Done creating garbage")

# Collect results
println("Waiting for workers...")
r1 = recv(p)
r2 = recv(p)

println("Worker 1 result:", r1)
println("Worker 2 result:", r2)
println("Expected: 4995000 each")
