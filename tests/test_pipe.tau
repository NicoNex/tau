testing = import("testing")
time = import("time")

slow_receiver = fn(p, n, done) {
	for i = 0; i < n; ++i {
		time.Sleep(20 * time.Millisecond)
		recv(p)
	}
	send(done, 1)
}

drain = fn(p, n, done) {
	time.Sleep(30 * time.Millisecond)
	for i = 0; i < n; ++i {
		recv(p)
	}
	send(done, 1)
}

receive_one = fn(p, done) {
	send(done, recv(p))
}

testing.Main([
		["an unbuffered send waits for a receiver", fn(t) {
				p = pipe()
				done = pipe(1)

				# The receiver takes its time. A send that does not wait for it
				# would put all three values down at once and return in no time.
				tau slow_receiver(p, 3, done)

				start = time.Mono()
				for i = 0; i < 3; ++i {
					send(p, i)
				}
				recv(done)
				t.Assert(time.Since(start) >= 40 * time.Millisecond, "send returned before the receiver took the value")
		}],

		["a buffered send does not wait until the buffer is full", fn(t) {
				p = pipe(4)

				# Four values fit, so none of these waits for a receiver.
				start = time.Mono()
				for i = 0; i < 4; ++i {
					send(p, i)
				}
				t.Assert(time.Since(start) < 20 * time.Millisecond, "a send waited even though the buffer had room")

				for i = 0; i < 4; ++i {
					t.AssertEq(recv(p), i)
				}
		}],

		["a full buffer makes the sender wait", fn(t) {
				p = pipe(1)
				done = pipe(1)

				tau drain(p, 2, done)

				start = time.Mono()
				send(p, 1)
				send(p, 2)
				recv(done)
				t.Assert(time.Since(start) >= 25 * time.Millisecond, "a send did not wait for room in a full buffer")
		}],

		["values already in the pipe are delivered after close", fn(t) {
				p = pipe(2)
				send(p, 1)
				send(p, 2)
				close(p)

				t.AssertEq(recv(p), 1)
				t.AssertEq(recv(p), 2)
				t.AssertEq(recv(p), null)
		}],

		["an unbuffered pipe hands the value over", fn(t) {
				p = pipe()
				done = pipe(1)

				tau receive_one(p, done)

				send(p, 42)
				t.AssertEq(recv(done), 42)

				close(p)
				t.AssertEq(recv(p), null)
		}]
])
