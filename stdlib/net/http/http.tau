# http - HTTP/1.1 client and server, in the shape of Go's net/http.
#
# A client sends a request and reads a response; a server accepts connections
# and hands each one to a handler, which is any function of (w, r). Headers
# are kept in a map whose keys are lowercase, so looking one up doesn't
# depend on how the other side chose to spell it.
#
# What is not here: TLS, chunked transfer encoding, keep alive. Every
# connection carries one exchange and is closed.

net = import("net")
strings = import("strings")
strconv = import("strconv")
bufio = import("bufio")

# ========== Status Codes ==========

StatusOK = 200
StatusCreated = 201
StatusAccepted = 202
StatusNoContent = 204
StatusMovedPermanently = 301
StatusFound = 302
StatusSeeOther = 303
StatusNotModified = 304
StatusTemporaryRedirect = 307
StatusPermanentRedirect = 308
StatusBadRequest = 400
StatusUnauthorized = 401
StatusForbidden = 403
StatusNotFound = 404
StatusMethodNotAllowed = 405
StatusRequestTimeout = 408
StatusConflict = 409
StatusPayloadTooLarge = 413
StatusUnsupportedMediaType = 415
StatusTooManyRequests = 429
StatusInternalServerError = 500
StatusNotImplemented = 501
StatusBadGateway = 502
StatusServiceUnavailable = 503
StatusGatewayTimeout = 504

statusText = {
	200: "OK",
	201: "Created",
	202: "Accepted",
	204: "No Content",
	301: "Moved Permanently",
	302: "Found",
	303: "See Other",
	304: "Not Modified",
	307: "Temporary Redirect",
	308: "Permanent Redirect",
	400: "Bad Request",
	401: "Unauthorized",
	403: "Forbidden",
	404: "Not Found",
	405: "Method Not Allowed",
	408: "Request Timeout",
	409: "Conflict",
	413: "Payload Too Large",
	415: "Unsupported Media Type",
	429: "Too Many Requests",
	500: "Internal Server Error",
	501: "Not Implemented",
	502: "Bad Gateway",
	503: "Service Unavailable",
	504: "Gateway Timeout"
}

# StatusText returns the reason phrase of a status code, empty when the code
# is not one of the known ones.
StatusText = fn(code) {
	if statusText[code] == null {
		return ""
	}
	return statusText[code]
}

# ========== Methods ==========

MethodGet = "GET"
MethodHead = "HEAD"
MethodPost = "POST"
MethodPut = "PUT"
MethodPatch = "PATCH"
MethodDelete = "DELETE"
MethodOptions = "OPTIONS"

# ========== URLs ==========

# ParseURL takes a URL apart: Scheme, Host with its port, Path, RawQuery and
# Query, which is the query string already split into a map.
ParseURL = fn(rawurl) {
	scheme = "http"
	rest = rawurl

	if strings.HasPrefix(rawurl, "http://") {
		rest = slice(rawurl, 7, len(rawurl))
	} else if strings.HasPrefix(rawurl, "https://") {
		return error("http: https is not supported")
	} else if strings.Contains(rawurl, "://") {
		return error("http: unsupported scheme in \"{rawurl}\"")
	}

	host = rest
	path = "/"

	if (i = strings.Index(rest, "/")) != -1 {
		host = slice(rest, 0, i)
		path = slice(rest, i, len(rest))
	}

	if host == "" {
		return error("http: no host in \"{rawurl}\"")
	}

	query = ""
	if (i = strings.Index(path, "?")) != -1 {
		query = slice(path, i + 1, len(path))
		path = slice(path, 0, i)
	}

	u = new()
	u.Scheme = scheme
	u.Host = if strings.Index(host, ":") == -1 { host + ":80" } else { host }
	u.Hostname = net.SplitHostPort(u.Host).Host
	u.Path = path
	u.RawQuery = query
	u.Query = ParseQuery(query)
	return u
}

# ParseQuery reads a query string into a map. A key without a value maps to
# the empty string, the way an empty field does.
ParseQuery = fn(raw) {
	out = {}
	if raw == "" {
		return out
	}

	pairs = strings.Split(raw, "&")
	for i = 0; i < len(pairs); ++i {
		p = pairs[i]
		if p == "" {
			continue
		}

		if (j = strings.Index(p, "=")) == -1 {
			out[unescape(p)] = ""
		} else {
			out[unescape(slice(p, 0, j))] = unescape(slice(p, j + 1, len(p)))
		}
	}
	return out
}

hexValue = fn(c) {
	if c >= "0" && c <= "9" {
		return bytes(c)[0] - 48
	}
	if c >= "a" && c <= "f" {
		return bytes(c)[0] - 87
	}
	if c >= "A" && c <= "F" {
		return bytes(c)[0] - 55
	}
	return -1
}

# unescape turns %XX back into the byte it stands for, and + into a space.
unescape = fn(s) {
	out = []
	for i = 0; i < len(s); ++i {
		c = s[i]

		if c == "+" {
			out = append(out, 32)
		} else if c == "%" && i + 2 < len(s) && hexValue(s[i + 1]) >= 0 && hexValue(s[i + 2]) >= 0 {
			out = append(out, hexValue(s[i + 1]) << 4 | hexValue(s[i + 2]))
			i = i + 2
		} else {
			out = append(out, bytes(c)[0])
		}
	}
	return string(bytes(out))
}

unreserved = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
hexDigits = "0123456789ABCDEF"

# Escape writes a string so that it can travel inside a URL.
Escape = fn(s) {
	b = bytes(s)
	out = ""

	for i = 0; i < len(b); ++i {
		c = string(bytes([b[i]]))
		if strings.Contains(unreserved, c) {
			out = out + c
		} else {
			out = out + "%" + hexDigits[b[i] >> 4] + hexDigits[b[i] & 0x0f]
		}
	}
	return out
}

# ========== Headers ==========

# newHeader returns an empty header map with the two ways of reaching into
# it: Get and Set, which don't care about case.
newHeader = fn() {{} }

# HeaderGet returns the value of a header, or an empty string.
HeaderGet = fn(h, name) {
	v = h[strings.ToLower(name)]
	if v == null {
		return ""
	}
	return v
}

HeaderSet = fn(h, name, value) {
	h[strings.ToLower(name)] = string(value)
	return h
}

# canonical writes a header name the way HTTP does: Content-Type.
canonical = fn(name) {
	parts = strings.Split(strings.ToLower(name), "-")
	for i = 0; i < len(parts); ++i {
		if len(parts[i]) > 0 {
			parts[i] = strings.ToUpper(slice(parts[i], 0, 1)) + slice(parts[i], 1, len(parts[i]))
		}
	}
	return strings.Join(parts, "-")
}

# readHeaders reads the header lines up to the empty one that ends them.
readHeaders = fn(r) {
	h = newHeader()

	for {
		line = r.ReadLine()
		if line == null || line == "" {
			return h
		}

		if (i = strings.Index(line, ":")) != -1 {
			name = strings.ToLower(strings.TrimSpace(slice(line, 0, i)))
			h[name] = strings.TrimSpace(slice(line, i + 1, len(line)))
		}
	}
}

# readBody returns as many bytes as Content-Length says. Without that header
# there is a body only if the sender is going to close the connection to mark
# its end, which is what toEnd is for: true for a response, false for a
# request, where waiting for a close that never comes would hang the server.
readBody = fn(r, h, toEnd) {
	length = HeaderGet(h, "content-length")

	if length == "" {
		if toEnd {
			return string(r.ReadAll())
		}
		return ""
	}
	if failed(n = strconv.Atoi(length)) {
		return error("http: bad Content-Length \"{length}\"")
	}
	if n <= 0 {
		return ""
	}
	return string(r.Read(n))
}

# ========== Requests and Responses ==========

# NewRequest builds a request. Body may be null for the methods that carry
# none.
NewRequest = fn(method, url, body) {
	if failed(u = ParseURL(url)) {
		return u
	}

	req = new()
	req.Method = if method == null { MethodGet } else { strings.ToUpper(method) }
	req.URL = url
	req.Path = u.Path
	req.RawQuery = u.RawQuery
	req.Query = u.Query
	req.Host = u.Host
	req.Header = newHeader()
	req.Body = if body == null { "" } else { string(body) }
	return req
}

newResponse = fn() {
	resp = new()
	resp.StatusCode = 0
	resp.Status = ""
	resp.Proto = "HTTP/1.1"
	resp.Header = newHeader()
	resp.Body = ""
	return resp
}

# ========== Client ==========

# NewClient returns a client. Timeout is in milliseconds and may be null.
NewClient = fn(timeout) {
	client = new()
	client.Timeout = if timeout == null { 30000 } else { timeout }

	# Do sends a request and returns the response.
	client.Do = fn(req) {
		if failed(u = ParseURL(req.URL)) {
			return u
		}
		if failed(conn = net.Dial("tcp", u.Host)) {
			return conn
		}
		conn.SetTimeout(client.Timeout)

		target = u.Path
		if u.RawQuery != "" {
			target = target + "?" + u.RawQuery
		}

		out = "{req.Method} {target} HTTP/1.1\r\n"
		out = out + "Host: {u.Hostname}\r\n"
		out = out + "Connection: close\r\n"

		if HeaderGet(req.Header, "user-agent") == "" {
			out = out + "User-Agent: tau-http/1.0\r\n"
		}

		ks = keys(req.Header)
		for i = 0; i < len(ks); ++i {
			out = out + "{canonical(ks[i])}: {req.Header[ks[i]]}\r\n"
		}

		if len(req.Body) > 0 {
			out = out + "Content-Length: {len(req.Body)}\r\n"
		}

		out = out + "\r\n" + req.Body

		if failed(n = conn.Write(out)) {
			conn.Close()
			return n
		}

		resp = readResponse(conn)
		conn.Close()
		return resp
	}

	client.Get = fn(url) {
		if failed(req = NewRequest(MethodGet, url, null)) {
			return req
		}
		return client.Do(req)
	}

	client.Post = fn(url, contentType, body) {
		if failed(req = NewRequest(MethodPost, url, body)) {
			return req
		}
		HeaderSet(req.Header, "content-type", if contentType == null { "text/plain" } else { contentType })
		return client.Do(req)
	}

	client.Head = fn(url) {
		if failed(req = NewRequest(MethodHead, url, null)) {
			return req
		}
		return client.Do(req)
	}

	return client
}

# readResponse reads a whole response off a connection.
readResponse = fn(conn) {
	r = bufio.NewReader(conn, 4096)

	line = r.ReadLine()
	if line == null || line == "" {
		return error("http: empty response")
	}

	parts = strings.SplitN(line, " ", 3)
	if len(parts) < 2 {
		return error("http: malformed status line \"{line}\"")
	}
	if failed(code = strconv.Atoi(parts[1])) {
		return error("http: malformed status code \"{parts[1]}\"")
	}

	resp = newResponse()
	resp.Proto = parts[0]
	resp.StatusCode = code
	resp.Status = if len(parts) > 2 { parts[2] } else { StatusText(code) }
	resp.Header = readHeaders(r)

	if failed(body = readBody(r, resp.Header, true)) {
		return body
	}
	resp.Body = body
	return resp
}

DefaultClient = NewClient(null)

Get = fn(url) { DefaultClient.Get(url) }
Post = fn(url, contentType, body) { DefaultClient.Post(url, contentType, body) }
Head = fn(url) { DefaultClient.Head(url) }

# ========== Server ==========

# newResponseWriter is what a handler writes into. Nothing reaches the
# connection until the handler is done: the status line comes first, and a
# handler is free to change its mind about it until it writes something.
newResponseWriter = fn() {
	w = new()
	w.statusCode = StatusOK
	w.headers = newHeader()
	w.body = ""

	w.Header = fn() { w.headers }
	w.WriteHeader = fn(code) { w.statusCode = code }

	w.Write = fn(data) {
		s = string(data)
		w.body = w.body + s
		return len(s)
	}

	w.WriteString = fn(s) { w.Write(s) }

	# response is the bytes to send back.
	w.response = fn() {
		out = "HTTP/1.1 {w.statusCode} {StatusText(w.statusCode)}\r\n"

		HeaderSet(w.headers, "content-length", len(w.body))
		if HeaderGet(w.headers, "content-type") == "" {
			HeaderSet(w.headers, "content-type", "text/plain; charset=utf-8")
		}
		HeaderSet(w.headers, "connection", "close")

		ks = keys(w.headers)
		for i = 0; i < len(ks); ++i {
			out = out + "{canonical(ks[i])}: {w.headers[ks[i]]}\r\n"
		}

		return out + "\r\n" + w.body
	}

	return w
}

# readRequest reads a request off a connection.
readRequest = fn(conn) {
	r = bufio.NewReader(conn, 4096)

	line = r.ReadLine()
	if line == null || line == "" {
		return error("http: empty request")
	}

	parts = strings.Split(line, " ")
	if len(parts) < 2 {
		return error("http: malformed request line \"{line}\"")
	}

	target = parts[1]
	query = ""
	if (i = strings.Index(target, "?")) != -1 {
		query = slice(target, i + 1, len(target))
		target = slice(target, 0, i)
	}

	req = new()
	req.Method = parts[0]
	req.Proto = if len(parts) > 2 { parts[2] } else { "HTTP/1.0" }
	req.Path = target
	req.URL = target
	req.RawQuery = query
	req.Query = ParseQuery(query)
	req.Header = readHeaders(r)
	req.Host = HeaderGet(req.Header, "host")
	req.RemoteAddr = conn.RemoteAddr

	if failed(body = readBody(r, req.Header, false)) {
		return body
	}
	req.Body = body
	return req
}

# NewServeMux returns a multiplexer. A pattern ending in "/" matches every
# path below it, anything else matches exactly, and the longest pattern that
# matches wins, as in Go.
NewServeMux = fn() {
	mux = new()
	mux.patterns = []
	mux.handlers = {}

	mux.Handle = fn(pattern, handler) {
		if mux.handlers[pattern] == null {
			mux.patterns = append(mux.patterns, pattern)
		}
		mux.handlers[pattern] = handler
		return null
	}

	mux.HandleFunc = fn(pattern, handler) { mux.Handle(pattern, handler) }

	# Handler returns the handler for a path, or null when none matches.
	mux.Handler = fn(path) {
		best = ""
		for i = 0; i < len(mux.patterns); ++i {
			p = mux.patterns[i]

			matches = if strings.HasSuffix(p, "/") { strings.HasPrefix(path, p) } else { path == p }
			if matches && len(p) > len(best) {
				best = p
			}
		}

		if best == "" {
			return null
		}
		return mux.handlers[best]
	}

	mux.ServeHTTP = fn(w, r) {
		h = mux.Handler(r.Path)
		if h == null {
			NotFound(w, r)
			return null
		}
		return h(w, r)
	}

	return mux
}

DefaultServeMux = NewServeMux()

Handle = fn(pattern, handler) { DefaultServeMux.Handle(pattern, handler) }
HandleFunc = fn(pattern, handler) { DefaultServeMux.HandleFunc(pattern, handler) }

# NotFound is the handler for a path nothing was registered for.
NotFound = fn(w, r) {
	w.WriteHeader(StatusNotFound)
	w.Write("404 page not found\n")
	return null
}

# Error replies with a message and a status code.
Error = fn(w, msg, code) {
	w.WriteHeader(code)
	w.Write(string(msg) + "\n")
	return null
}

# Redirect replies with a redirect to url.
Redirect = fn(w, r, url, code) {
	HeaderSet(w.Header(), "location", url)
	w.WriteHeader(if code == null { StatusFound } else { code })
	w.Write("")
	return null
}

# serve reads one exchange off a connection and answers it.
serve = fn(conn, handler) {
	w = newResponseWriter()

	if failed(req = readRequest(conn)) {
		w.WriteHeader(StatusBadRequest)
		w.Write("400 bad request\n")
	} else if type(handler) == "closure" {
		handler(w, req)
	} else {
		handler.ServeHTTP(w, req)
	}

	conn.Write(w.response())
	conn.Close()
	return null
}

# NewServer returns a server. Handler is a mux or any function of (w, r).
NewServer = fn(addr, handler) {
	server = new()
	server.Addr = addr
	server.Handler = if handler == null { DefaultServeMux } else { handler }
	server.running = false

	# ListenAndServe accepts connections until Close is called, one tau
	# routine per connection so that a slow client holds up nobody.
	server.ListenAndServe = fn() {
		if failed(ln = net.Listen("tcp", server.Addr)) {
			return ln
		}

		server.ln = ln
		server.running = true

		for server.running {
			if failed(conn = ln.Accept()) {
				if !server.running {
					return null
				}
				continue
			}
			tau serve(conn, server.Handler)
		}

		return null
	}

	server.Close = fn() {
		server.running = false
		if server.ln != null {
			return server.ln.Close()
		}
		return null
	}

	return server
}

# ListenAndServe serves handler on addr until something goes wrong.
ListenAndServe = fn(addr, handler) {
	return NewServer(addr, handler).ListenAndServe()
}
