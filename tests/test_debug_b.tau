# This will be called from outside
PublicCallA = fn() {
    print("Inside PublicCallA, type of a: ")
    print(type(a))
    print("\n")

    print("Inside PublicCallA, type of a.PublicFunc: ")
    print(type(a.PublicFunc))
    print("\n")

    return a.PublicFunc()
}

